+/// A borrowed native text edit before text, selection, composition or history
+/// is changed. The replacement range addresses Unicode boundaries in the
+/// current UTF-8 text; preedit is the composition that will remain afterward.
+#[doc(hidden)]
+pub struct TextInputEdit<'a> {
+    pub(crate) current_text: &'a str,
+    pub(crate) replacement_range: core::ops::Range<usize>,
+    pub(crate) inserted_text: &'a str,
+    pub(crate) preedit_text: &'a str,
+    pub(crate) single_line: bool,
+    pub(crate) password: bool,
+    pub(crate) numeric: bool,
+    pub(crate) enabled: bool,
+    pub(crate) read_only: bool,
+}
+
+impl TextInputEdit<'_> {
+    /// The one native text snapshot that will be edited.
+    pub fn current_text(&self) -> &str {
+        self.current_text
+    }
+
+    /// The exact byte range replaced by the inserted text.
+    pub fn replacement_range(&self) -> core::ops::Range<usize> {
+        self.replacement_range.clone()
+    }
+
+    /// The same borrowed insertion consumed by the accepted mutation.
+    pub fn inserted_text(&self) -> &str {
+        self.inserted_text
+    }
+
+    /// The composition displayed after the accepted mutation.
+    pub fn preedit_text(&self) -> &str {
+        self.preedit_text
+    }
+
+    /// Whether this native input is a single-line field.
+    pub fn is_single_line(&self) -> bool {
+        self.single_line
+    }
+
+    /// Whether this native input displays a password.
+    pub fn is_password(&self) -> bool {
+        self.password
+    }
+
+    /// Whether this native input accepts Number or Decimal input.
+    pub fn is_numeric(&self) -> bool {
+        self.numeric
+    }
+
+    /// Whether this native input is enabled.
+    pub fn is_enabled(&self) -> bool {
+        self.enabled
+    }
+
+    /// Whether this native input is read-only.
+    pub fn is_read_only(&self) -> bool {
+        self.read_only
+    }
+}
