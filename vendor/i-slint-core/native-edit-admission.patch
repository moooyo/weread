+/// SharedString snapshots retain existing storage without copying payloads.
+/// The expected offsets are supplied separately because middle-click performs
+/// its original cursor notification between admission and insertion.
+struct NativeTextEditSnapshot {
+    text: SharedString,
+    preedit_text: SharedString,
+    preedit_selection: PreEditSelection,
+    input_type: InputType,
+    single_line: bool,
+    enabled: bool,
+    read_only: bool,
+    has_focus: bool,
+}
+
+impl NativeTextEditSnapshot {
+    fn capture(input: Pin<&TextInput>) -> Self {
+        Self {
+            text: input.text(),
+            preedit_text: input.preedit_text(),
+            preedit_selection: input.preedit_selection(),
+            input_type: input.input_type(),
+            single_line: input.single_line(),
+            enabled: input.enabled(),
+            read_only: input.read_only(),
+            has_focus: input.has_focus(),
+        }
+    }
+
+    fn matches(&self, input: Pin<&TextInput>, anchor: i32, cursor: i32) -> bool {
+        input.text() == self.text
+            && input.preedit_text() == self.preedit_text
+            && input.preedit_selection() == self.preedit_selection
+            && input.input_type() == self.input_type
+            && input.single_line() == self.single_line
+            && input.enabled() == self.enabled
+            && input.read_only() == self.read_only
+            && input.has_focus() == self.has_focus
+            && input.anchor_position_byte_offset() == anchor
+            && input.cursor_position_byte_offset() == cursor
+    }
+}
