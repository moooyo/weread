+    entered: bool,
+    owner: Option<ItemTreeRc>,
+}
+
+impl TextInputEditGuard<'_> {
+    pub(crate) fn requires_snapshot_validation(&self) -> bool {
+        self.entered
+    }
+
+    pub(crate) fn current_root_matches(&self) -> bool {
+        self.owner.as_ref().is_none_or(|owner| {
+            self.window
+                .try_component()
+                .is_some_and(|current| ItemTreeRc::ptr_eq(owner, &current))
+        })
+    }
+}
+
+impl Drop for TextInputEditGuard<'_> {
+    fn drop(&mut self) {
+        if self.entered {
+            self.window.text_input_edit_entered.set(false);
