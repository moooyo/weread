 impl TextInput {
+    fn admit_native_edit<'a>(
+        self: Pin<&Self>,
+        inserted_text: &str,
+        preedit_text: &str,
+        replacement: TextEditReplacement,
+        window_adapter: &'a Rc<dyn WindowAdapter>,
+    ) -> Option<crate::window::TextInputEditGuard<'a>> {
+        let window = WindowInner::from_pub(window_adapter.window());
+        if window.text_input_edit_in_progress() {
+            return None;
+        }
+        let text = self.text();
+        let old_cursor = self.cursor_position_byte_offset();
+        let old_anchor = self.anchor_position_byte_offset();
+        let old_preedit = self.preedit_text();
+        let old_preedit_selection = self.preedit_selection();
+        let input_type = self.input_type();
+        let single_line = self.single_line();
+        let enabled = self.enabled();
+        let read_only = self.read_only();
+        let has_focus = self.has_focus();
+        let cursor = safe_byte_offset(old_cursor, &text);
+        let anchor = safe_byte_offset(old_anchor, &text);
+        let range = match replacement {
+            TextEditReplacement::Selection => anchor.min(cursor)..anchor.max(cursor),
+            TextEditReplacement::AtCursor => cursor..cursor,
+            TextEditReplacement::AtOffset(offset) => {
+                let offset = safe_byte_offset(offset, &text);
+                offset..offset
+            }
+            TextEditReplacement::AroundCursor(range) => {
+                let cursor = cursor as i32;
+                let start = safe_byte_offset(cursor.saturating_add(range.start), &text);
+                let end = safe_byte_offset(cursor.saturating_add(range.end), &text);
+                start.min(end)..start.max(end)
+            }
+            TextEditReplacement::Exact(range) => range,
+        };
+        if range.start > range.end
+            || range.end > text.len()
+            || !text.is_char_boundary(range.start)
+            || !text.is_char_boundary(range.end)
+        {
+            return None;
+        }
+        let edit = crate::api::TextInputEdit {
+            current_text: &text,
+            replacement_range: range,
+            inserted_text,
+            preedit_text,
+            single_line,
+            password: matches!(input_type, InputType::Password),
+            numeric: matches!(input_type, InputType::Number | InputType::Decimal),
+            enabled,
+            read_only,
+        };
+        let guard = window.text_input_edit_guard(&edit)?;
+        // A Fn may still mutate native properties or replace the root through a
+        // weak handle. Never spend its admission on a different native snapshot.
+        if !guard.current_root_matches()
+            || self.text() != text
+            || self.cursor_position_byte_offset() != old_cursor
+            || self.anchor_position_byte_offset() != old_anchor
+            || self.preedit_text() != old_preedit
+            || self.preedit_selection() != old_preedit_selection
+            || self.input_type() != input_type
+            || self.single_line() != single_line
+            || self.enabled() != enabled
+            || self.read_only() != read_only
+            || self.has_focus() != has_focus
+        {
+            return None;
+        }
+        Some(guard)
+    }
