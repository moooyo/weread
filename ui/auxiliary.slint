import { Theme } from "theme.slint";
import { Strings } from "strings.slint";
import { ActionButton, IconButton, Icon, HeaderPager, SegmentedControl, SegmentedOption, ProgressTrack, PressArea, SwipeTouchArea, DashedOutline } from "widgets.slint";

export struct PublicationRow {
    id: string,
    title: string,
    subtitle: string,
    meta: string,
    initial: string,
    unread: int,
    cached: bool,
}

export struct StatisticMetric { label: string, value: string }
export struct StatisticBar { label: string, value: float, selected: bool, future: bool }
export struct RankingEntry { id: string, title: string, subtitle: string, value: float }
export struct PreferenceEntry { label: string, value: float, offset: float, percent: int, tone: int }
export struct SettingEntry {
    id: string,
    title: string,
    subtitle: string,
    value: string,
    kind: string,
    checked: bool,
    enabled: bool,
    // Applies only while the row above it is on; drawn indented beneath it.
    nested: bool,
    options: [SegmentedOption],
    selected-value: string,
}

export global AuxiliaryModel {
    in-out property <string> publications-title;
    in-out property <string> publications-query;
    in-out property <string> publications-sort: "recent";
    in-out property <string> publications-account-id;
    in-out property <[PublicationRow]> publications-rows;
    in-out property <int> publications-page: 1;
    in-out property <int> publications-page-count: 1;
    in-out property <string> publications-status;
    in-out property <bool> publications-busy: false;

    in-out property <string> stats-period: "week";
    in-out property <string> stats-period-label;
    in-out property <string> stats-summary;
    in-out property <string> stats-chart-title;
    in-out property <string> stats-selected-label;
    in-out property <string> stats-status;
    in-out property <bool> stats-can-next: false;
    in-out property <[StatisticMetric]> stats-metrics;
    in-out property <[StatisticBar]> stats-bars;
    in-out property <[RankingEntry]> stats-ranking;
    in-out property <[int]> stats-calendar;
    in-out property <int> stats-calendar-offset: 0;
    in-out property <string> stats-calendar-label;
    in-out property <string> stats-calendar-days;
    in-out property <[string]> stats-weekdays;
    in-out property <[PreferenceEntry]> stats-preferences;

    in-out property <string> settings-subpage;
    in-out property <string> settings-account-name;
    in-out property <string> settings-account-initial;
    in-out property <bool> settings-account-active: false;
    in-out property <[SettingEntry]> settings-rows;
    in-out property <[SettingEntry]> settings-groups;
    in-out property <string> settings-status;
    callback event(string, string);
}

component UnderlineTab inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked();
    min-width: 48px;
    preferred-width: label.preferred-width + 20px;
    horizontal-stretch: 0;
    height: 48px;
    background: touch.pressed ? Theme.ink : Theme.paper;
    accessible-role: tab;
    accessible-label: root.text;
    accessible-item-selected: root.selected;
    label := Text {
        text: root.text;
        color: touch.pressed ? Theme.paper : root.selected ? Theme.ink : Theme.secondary;
        font-family: Theme.ui-font;
        font-size: 17px;
        font-weight: root.selected ? 700 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if root.selected: Rectangle {
        y: parent.height - 3px;
        height: 3px;
        background: Theme.ink;
    }
    touch := PressArea { clicked => { root.clicked(); } }
}

component PublicationItem inherits Rectangle {
    in property <PublicationRow> entry;
    in property <bool> articles;
    callback open();
    callback download();
    callback paged(int);
    height: 72px;
    background: Theme.paper;
    HorizontalLayout {
        spacing: 12px;
        content := Rectangle {
            horizontal-stretch: 1;
            background: touch.pressed ? Theme.ink : Theme.paper;
            border-radius: 0px;
            accessible-role: button;
            accessible-label: root.entry.title;
            HorizontalLayout {
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 12px;
                if !root.articles: Rectangle {
                    width: 48px;
                    height: 48px;
                    border-radius: 24px;
                    border-width: 2px;
                    border-color: Theme.ink;
                    background: root.entry.unread > 0 ? Theme.ink : Theme.fill;
                    Text {
                        text: root.entry.initial;
                        color: root.entry.unread > 0 ? Theme.paper : Theme.ink;
                        font-family: Theme.serif-font;
                        font-size: 21px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 4px;
                    Rectangle {
                        height: 28px;
                        if root.articles && root.entry.unread > 0: Rectangle {
                            y: (parent.height - 8px) / 2;
                            width: 8px;
                            height: 8px;
                            border-radius: 4px;
                            background: touch.pressed ? Theme.paper : Theme.ink;
                        }
                        Text {
                            x: root.articles && root.entry.unread > 0 ? 20px : 0px;
                            width: parent.width - self.x;
                            text: root.entry.title;
                            color: touch.pressed ? Theme.paper : Theme.ink;
                            font-family: Theme.ui-font;
                            font-size: 18px;
                            font-weight: root.entry.unread > 0 ? 700 : 400;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                    Rectangle {
                        height: 20px;
                        Text {
                            x: 0px;
                            width: parent.width - self.x;
                            text: root.articles ? root.entry.meta : root.entry.subtitle;
                            color: touch.pressed ? Theme.paper : Theme.secondary;
                            font-family: Theme.ui-font;
                            font-size: 14px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }
                if !root.articles: VerticalLayout {
                    alignment: center;
                    spacing: 4px;
                    Text {
                        text: root.entry.meta;
                        color: touch.pressed ? Theme.paper : Theme.secondary;
                        font-family: Theme.ui-font;
                        font-size: 14px;
                        horizontal-alignment: right;
                    }
                    if root.entry.unread > 0: Rectangle {
                        width: 28px;
                        height: 24px;
                        border-radius: 0px;
                        background: touch.pressed ? Theme.paper : Theme.ink;
                        Text {
                            text: root.entry.unread;
                            color: touch.pressed ? Theme.ink : Theme.paper;
                            font-family: Theme.ui-font;
                            font-size: 14px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
                if Theme.scribe && !root.articles: Rectangle {
                    width: 24px;
                    Icon { y: (parent.height - 24px) / 2; kind: "next"; inverted: touch.pressed; }
                }
            }
            // Rows also carry the list swipe, as in Library and the article list.
            touch := SwipeTouchArea { tapped => { root.open(); } swiped(delta) => { root.paged(delta); } }
        }
        if root.articles && !root.entry.cached: Rectangle {
            width: Theme.touch-size;
            Rectangle {
                y: (parent.height - Theme.touch-size) / 2;
                width: Theme.touch-size;
                height: Theme.touch-size;
                border-width: Theme.scribe ? 1px : 2px;
                border-color: Theme.ink;
                border-radius: 0px;
                background: download-touch.pressed ? Theme.ink : Theme.paper;
                accessible-role: button;
                accessible-label: Strings.download;
                Icon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    kind: "download";
                    inverted: download-touch.pressed;
                }
                download-touch := PressArea {
                    clicked => { root.download(); }
                }
            }
        }
        if root.articles && root.entry.cached: Text {
            text: Strings.downloaded;
            font-family: Theme.ui-font;
            font-size: 14px;
            color: Theme.secondary;
            vertical-alignment: center;
        }
    }
    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
}

export component PublicationScreen inherits Rectangle {
    private property <bool> showing-accounts: AuxiliaryModel.publications-account-id == "";
    background: Theme.paper;
    VerticalLayout {
        spacing: 0px;
        Rectangle {
            height: 52px;
            HorizontalLayout {
                padding-left: Theme.page-margin;
                padding-right: 8px;
                padding-top: 2px;
                padding-bottom: 2px;
                spacing: 8px;
                Rectangle {
                    height: 48px;
                    horizontal-stretch: 1;
                    accessible-role: button;
                    accessible-label: Strings.publication-search;
                    Rectangle {
                        x: 0px; y: 2px; width: parent.width; height: 44px;
                        border-width: 2px;
                        border-color: Theme.ink;
                        background: search-touch.pressed ? Theme.ink : Theme.paper;
                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            spacing: 12px;
                            Rectangle { width: 24px; Icon { y: (parent.height - 24px) / 2; kind: "search"; inverted: search-touch.pressed; } }
                            Text {
                                text: AuxiliaryModel.publications-query == "" ? Strings.publication-search : AuxiliaryModel.publications-query;
                                color: search-touch.pressed ? Theme.paper : AuxiliaryModel.publications-query == "" ? Theme.muted : Theme.ink;
                                font-family: Theme.ui-font;
                                font-size: 18px;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                        }
                    }
                    search-touch := PressArea { clicked => { AuxiliaryModel.event("mp.focus", ""); } }
                }
                IconButton { icon: "sync"; label: Strings.sync; enabled: !AuxiliaryModel.publications-busy; text: Theme.scribe ? Strings.sync : ""; clicked => { AuxiliaryModel.event("mp.sync", ""); } }
            }
        }
        Rectangle {
            height: 48px;
            HorizontalLayout {
                padding-left: root.showing-accounts ? Theme.page-margin : 8px;
                padding-right: 8px;
                spacing: 0px;
                if !root.showing-accounts: IconButton { icon: "back"; label: Strings.back; clicked => { AuxiliaryModel.event("mp.back", ""); } }
                if !root.showing-accounts: Rectangle { width: 4px; }
                Text {
                    text: root.showing-accounts ? Strings.publications : AuxiliaryModel.publications-title;
                    font-family: Theme.serif-font;
                    font-size: 28px;
                    font-weight: 700;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: root.showing-accounts ? 0 : 1;
                }
                if root.showing-accounts: Rectangle { width: Theme.scribe ? 16px : 8px; }
                if root.showing-accounts: UnderlineTab { text: Strings.recent-update; selected: AuxiliaryModel.publications-sort == "recent"; clicked => { AuxiliaryModel.event("mp.sort", "recent"); } }
                if root.showing-accounts: UnderlineTab { text: Strings.unread; selected: AuxiliaryModel.publications-sort == "unread"; clicked => { AuxiliaryModel.event("mp.sort", "unread"); } }
                if root.showing-accounts: UnderlineTab { text: Strings.name; selected: AuxiliaryModel.publications-sort == "name"; clicked => { AuxiliaryModel.event("mp.sort", "name"); } }
                if root.showing-accounts: Rectangle { horizontal-stretch: 1; }
                HeaderPager {
                    current: AuxiliaryModel.publications-page;
                    total: AuxiliaryModel.publications-page-count;
                    step(direction) => { AuxiliaryModel.event("mp.page", "" + direction); }
                    jump => { AuxiliaryModel.event("mp.jump", ""); }
                }
            }
        }
        Rectangle { height: 1px; background: Theme.line; }
        Rectangle {
            vertical-stretch: 1;
            clip: true;
            SwipeTouchArea { swiped(delta) => { AuxiliaryModel.event("mp.page", "" + delta); } }
            VerticalLayout {
                padding-left: Theme.page-margin;
                padding-right: Theme.page-margin;
                spacing: 0px;
                for entry in AuxiliaryModel.publications-rows: PublicationItem {
                    entry: entry;
                    articles: !root.showing-accounts;
                    open => { AuxiliaryModel.event(root.showing-accounts ? "mp.account" : "mp.article", entry.id); }
                    download => { AuxiliaryModel.event("mp.download", entry.id); }
                    paged(delta) => { AuxiliaryModel.event("mp.page", "" + delta); }
                }
                Rectangle { vertical-stretch: 1; }
            }
            if AuxiliaryModel.publications-rows.length == 0: VerticalLayout {
                padding: Theme.page-margin;
                alignment: center;
                spacing: 12px;
                Text { text: Strings.empty-publications; font-family: Theme.serif-font; font-size: 24px; font-weight: 700; horizontal-alignment: center; }
                if AuxiliaryModel.publications-status != "": Text { text: AuxiliaryModel.publications-status; font-family: Theme.ui-font; font-size: 16px; color: Theme.secondary; horizontal-alignment: center; wrap: word-wrap; }
            }
        }
        if AuxiliaryModel.publications-status != "" && AuxiliaryModel.publications-rows.length > 0: Text {
            height: 32px;
            text: AuxiliaryModel.publications-status;
            font-family: Theme.ui-font;
            font-size: 14px;
            color: Theme.secondary;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

component RankingRow inherits Rectangle {
    in property <RankingEntry> entry;
    in property <int> index;
    callback clicked();
    height: 48px;
    accessible-role: button;
    accessible-label: root.entry.title + " " + root.entry.subtitle;
    background: touch.pressed ? Theme.ink : Theme.paper;
    VerticalLayout {
        spacing: 6px;
        padding-top: 4px;
        padding-bottom: 6px;
        HorizontalLayout {
            spacing: 12px;
            Text { text: (root.index + 1) + ". " + root.entry.title; font-family: Theme.ui-font; font-size: 16px; color: touch.pressed ? Theme.paper : Theme.ink; overflow: elide; horizontal-stretch: 1; }
            Text { text: root.entry.subtitle; font-family: Theme.ui-font; font-size: 15px; color: touch.pressed ? Theme.paper : Theme.secondary; }
        }
        ProgressTrack { value: root.entry.value; height: 6px; }
    }
    touch := PressArea { clicked => { root.clicked(); } }
}

component StatisticsPeriodControl inherits SegmentedControl {
    options: [
        {id: "week", label: Strings.week},
        {id: "month", label: Strings.month},
        {id: "year", label: Strings.year},
        {id: "total", label: Strings.total}
    ];
    value: AuxiliaryModel.stats-period;
    chosen(value) => { AuxiliaryModel.event("stats.period", value); }
}

component StatisticsPeriodNavigation inherits Rectangle {
    height: 48px;
    HorizontalLayout {
        spacing: 4px;
        IconButton { icon: "back"; label: Strings.previous-period; enabled: AuxiliaryModel.stats-period != "total"; clicked => { AuxiliaryModel.event("stats.previous", ""); } }
        Text { text: AuxiliaryModel.stats-period-label; font-family: Theme.ui-font; font-size: 17px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
        IconButton { icon: "next"; label: Strings.next-period; enabled: AuxiliaryModel.stats-can-next; clicked => { AuxiliaryModel.event("stats.next", ""); } }
    }
}

export component StatisticsScreen inherits Rectangle {
    background: Theme.paper;
    VerticalLayout {
        spacing: 0px;
        Rectangle {
            height: 56px;
            HorizontalLayout {
                padding-left: Theme.page-margin;
                padding-right: Theme.page-margin;
                spacing: 16px;
                Text { text: Strings.reading-statistics; font-family: Theme.serif-font; font-size: 28px; font-weight: 700; vertical-alignment: center; }
                Text { text: AuxiliaryModel.stats-status; font-family: Theme.ui-font; font-size: 14px; color: Theme.secondary; vertical-alignment: center; horizontal-alignment: right; overflow: elide; horizontal-stretch: 1; }
            }
        }
        Rectangle {
            height: Theme.scribe ? 64px : 48px;
            HorizontalLayout {
                padding-left: Theme.page-margin;
                padding-right: Theme.page-margin;
                padding-top: Theme.scribe ? 8px : 0px;
                padding-bottom: Theme.scribe ? 8px : 0px;
                spacing: Theme.scribe ? 16px : 0px;
                if !Theme.scribe: StatisticsPeriodControl { horizontal-stretch: 1; }
                if Theme.scribe: StatisticsPeriodControl { width: 380px; }
                if Theme.scribe: Rectangle { horizontal-stretch: 1; }
                if Theme.scribe: StatisticsPeriodNavigation { width: 320px; }
            }
        }
        if !Theme.scribe: Rectangle {
            height: 48px;
            HorizontalLayout {
                padding-left: Theme.page-margin - 8px;
                padding-right: Theme.page-margin - 8px;
                StatisticsPeriodNavigation { horizontal-stretch: 1; }
            }
        }
        Rectangle {
            height: Theme.scribe ? 96px : 108px;
            if !Theme.scribe: VerticalLayout {
                padding-left: Theme.page-margin;
                padding-right: Theme.page-margin;
                padding-bottom: 12px;
                spacing: 10px;
                HorizontalLayout {
                    spacing: 12px;
                    Text { text: AuxiliaryModel.stats-summary; font-family: Theme.serif-font; font-size: 32px; font-weight: 700; vertical-alignment: center; overflow: elide; }
                    Text { text: Strings.reading-time; font-family: Theme.ui-font; font-size: 15px; color: Theme.secondary; vertical-alignment: center; horizontal-stretch: 1; }
                }
                HorizontalLayout {
                    spacing: 12px;
                    for metric in AuxiliaryModel.stats-metrics: VerticalLayout {
                        spacing: 4px;
                        Text { text: metric.value; font-family: Theme.ui-font; font-size: 19px; font-weight: 700; overflow: elide; }
                        Text { text: metric.label; font-family: Theme.ui-font; font-size: 14px; color: Theme.secondary; overflow: elide; }
                    }
                }
            }
            if Theme.scribe: HorizontalLayout {
                padding-left: Theme.page-margin;
                padding-right: Theme.page-margin;
                padding-bottom: 16px;
                spacing: 16px;
                VerticalLayout {
                    horizontal-stretch: 1.7;
                    alignment: end;
                    spacing: 4px;
                    Text { text: Strings.reading-time; font-family: Theme.ui-font; font-size: 15px; color: Theme.secondary; }
                    Text { text: AuxiliaryModel.stats-summary; font-family: Theme.serif-font; font-size: 32px; font-weight: 700; overflow: elide; }
                }
                for metric in AuxiliaryModel.stats-metrics: VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: end;
                    spacing: 4px;
                    Text { text: metric.label; font-family: Theme.ui-font; font-size: 15px; color: Theme.secondary; overflow: elide; }
                    Text { text: metric.value; font-family: Theme.ui-font; font-size: 22px; font-weight: 700; overflow: elide; }
                }
            }
            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
        }
        Rectangle {
            height: Theme.scribe ? 256px : 240px;
            VerticalLayout {
                padding-left: Theme.page-margin;
                padding-right: Theme.page-margin;
                padding-top: 12px;
                padding-bottom: 12px;
                spacing: 8px;
                HorizontalLayout {
                    height: 48px;
                    spacing: 8px;
                    Text { text: AuxiliaryModel.stats-chart-title; font-family: Theme.ui-font; font-size: 18px; font-weight: 700; horizontal-stretch: 1; vertical-alignment: center; }
                    Text { text: AuxiliaryModel.stats-selected-label; font-family: Theme.ui-font; font-size: 15px; color: Theme.secondary; horizontal-alignment: right; vertical-alignment: center; overflow: elide; }
                    IconButton { icon: "back"; label: Strings.previous-value; enabled: AuxiliaryModel.stats-bars.length > 0; clicked => { AuxiliaryModel.event("stats.bar-previous", ""); } }
                    IconButton { icon: "next"; label: Strings.next-value; enabled: AuxiliaryModel.stats-bars.length > 0; clicked => { AuxiliaryModel.event("stats.bar-next", ""); } }
                }
                Rectangle {
                    height: Theme.scribe ? 144px : 128px;
                    accessible-role: button;
                    accessible-label: AuxiliaryModel.stats-chart-title + " " + AuxiliaryModel.stats-selected-label;
                    HorizontalLayout {
                        spacing: AuxiliaryModel.stats-bars.length > 14 ? 4px : 10px;
                        for bar in AuxiliaryModel.stats-bars: Rectangle {
                            horizontal-stretch: 1;
                            Rectangle {
                                y: parent.height - self.height;
                                height: bar.future ? 0px : max(2px, parent.height * clamp(bar.value, 0, 1));
                                background: bar.future ? Theme.paper : bar.selected ? Theme.ink : bar.value == 0 ? Theme.fill : Theme.muted;
                            }
                        }
                    }
                    Rectangle { y: parent.height - 2px; height: 2px; background: Theme.ink; }
                    TouchArea {
                        enabled: AuxiliaryModel.stats-bars.length > 0;
                        clicked => {
                            AuxiliaryModel.event("stats.bar", "" + min(AuxiliaryModel.stats-bars.length - 1, max(0, floor(self.mouse-x / self.width * AuxiliaryModel.stats-bars.length))));
                        }
                    }
                }
                HorizontalLayout {
                    height: 20px;
                    spacing: AuxiliaryModel.stats-bars.length > 14 ? 4px : 10px;
                    for bar in AuxiliaryModel.stats-bars: Text {
                        text: bar.label;
                        font-family: Theme.ui-font;
                        font-size: 14px;
                        font-weight: bar.selected ? 700 : 400;
                        color: bar.selected ? Theme.ink : Theme.secondary;
                        horizontal-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                }
            }
            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
        }
        if !Theme.scribe: Rectangle {
            vertical-stretch: 1;
            clip: true;
            VerticalLayout {
                padding-left: Theme.page-margin;
                padding-right: Theme.page-margin;
                padding-top: 12px;
                spacing: 0px;
                Text { text: Strings.reading-ranking; font-family: Theme.ui-font; font-size: 18px; font-weight: 700; height: 28px; }
                for entry[index] in AuxiliaryModel.stats-ranking: RankingRow {
                    entry: entry;
                    index: index;
                    clicked => { AuxiliaryModel.event("stats.open", entry.id); }
                }
                if AuxiliaryModel.stats-ranking.length == 0: Text { text: Strings.stats-empty; font-family: Theme.ui-font; font-size: 16px; color: Theme.secondary; wrap: word-wrap; }
                Rectangle { vertical-stretch: 1; }
            }
        }
        // Scribe places the ranking and the calendar side by side. Calendar days are
        // 40px cells with legible dates instead of 16px strips.
        if Theme.scribe: Rectangle {
            height: max(52px + max(1, AuxiliaryModel.stats-ranking.length) * 48px, AuxiliaryModel.stats-calendar.length > 0 ? 112px + ceil(AuxiliaryModel.stats-calendar.length / 7.0) * 44px : 0px);
            clip: true;
            HorizontalLayout {
                padding-left: Theme.page-margin;
                padding-right: Theme.page-margin;
                padding-top: 12px;
                padding-bottom: 12px;
                spacing: 32px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 0px;
                    Text { text: Strings.reading-ranking; font-family: Theme.ui-font; font-size: 18px; font-weight: 700; height: 28px; }
                    for entry[index] in AuxiliaryModel.stats-ranking: RankingRow {
                        entry: entry;
                        index: index;
                        clicked => { AuxiliaryModel.event("stats.open", entry.id); }
                    }
                    if AuxiliaryModel.stats-ranking.length == 0: Text { text: Strings.stats-empty; font-family: Theme.ui-font; font-size: 16px; color: Theme.secondary; wrap: word-wrap; }
                    Rectangle { vertical-stretch: 1; }
                }
                if AuxiliaryModel.stats-calendar.length > 0: VerticalLayout {
                    width: (root.width - Theme.page-margin * 2 - 32px) / 2;
                    spacing: 8px;
                    HorizontalLayout {
                        height: 28px;
                        spacing: 12px;
                        Text { text: Strings.reading-calendar; font-family: Theme.ui-font; font-size: 18px; font-weight: 700; vertical-alignment: center; }
                        Text { text: AuxiliaryModel.stats-calendar-label; font-family: Theme.ui-font; font-size: 14px; color: Theme.secondary; horizontal-stretch: 1; vertical-alignment: center; }
                    }
                    HorizontalLayout {
                        height: 20px;
                        spacing: 4px;
                        for day in AuxiliaryModel.stats-weekdays: Text { text: day; font-family: Theme.ui-font; font-size: 14px; color: Theme.secondary; horizontal-alignment: center; horizontal-stretch: 1; }
                    }
                    Rectangle {
                        height: ceil(AuxiliaryModel.stats-calendar.length / 7.0) * 44px - 4px;
                        for level[index] in AuxiliaryModel.stats-calendar: Rectangle {
                            x: mod(index, 7) * (parent.width + 4px) / 7;
                            y: floor(index / 7.0) * 44px;
                            width: (parent.width - 24px) / 7;
                            height: 40px;
                            border-radius: 0px;
                            border-width: level == 0 ? 1px : 0px;
                            border-color: Theme.line;
                            background: level < 0 ? Theme.paper : level >= 3 ? Theme.ink : level == 2 ? Theme.muted : level == 1 ? Theme.fill : Theme.paper;
                            Text {
                                text: level < 0 ? "" : "" + (index - AuxiliaryModel.stats-calendar-offset + 1);
                                color: level >= 2 ? Theme.paper : Theme.ink;
                                font-family: Theme.ui-font;
                                font-size: 15px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                    HorizontalLayout {
                        height: 20px;
                        spacing: 6px;
                        Text { text: Strings.less; font-family: Theme.ui-font; font-size: 14px; color: Theme.secondary; vertical-alignment: center; }
                        for level in [0, 1, 2, 3]: Rectangle {
                            width: 18px;
                            height: 18px;
                            border-width: level == 0 ? 1px : 0px;
                            border-color: Theme.line;
                            background: level == 3 ? Theme.ink : level == 2 ? Theme.muted : level == 1 ? Theme.fill : Theme.paper;
                        }
                        Text { text: Strings.more-amount; font-family: Theme.ui-font; font-size: 14px; color: Theme.secondary; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; }
                        Text { text: AuxiliaryModel.stats-calendar-days; font-family: Theme.ui-font; font-size: 14px; color: Theme.secondary; vertical-alignment: center; horizontal-alignment: right; }
                    }
                    Rectangle { vertical-stretch: 1; }
                }
            }
        }
        if Theme.scribe && AuxiliaryModel.stats-preferences.length > 0: Rectangle {
            height: 88px + ceil(AuxiliaryModel.stats-preferences.length / 3.0) * 28px;
            VerticalLayout {
                padding-left: Theme.page-margin;
                padding-right: Theme.page-margin;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 8px;
                Text { text: Strings.reading-preferences; font-family: Theme.ui-font; font-size: 18px; font-weight: 700; }
                Rectangle {
                    height: 28px;
                    border-width: 2px;
                    border-color: Theme.ink;
                    border-radius: 0px;
                    clip: true;
                    for preference in AuxiliaryModel.stats-preferences: Rectangle {
                        x: 2px + (parent.width - 4px) * preference.offset;
                        y: 2px;
                        width: (parent.width - 4px) * preference.value;
                        height: parent.height - 4px;
                        clip: true;
                        background: preference.tone == 0 ? Theme.ink : preference.tone == 1 ? Theme.secondary : preference.tone == 2 ? Theme.line : preference.tone == 3 ? Theme.fill : Theme.paper;
                        Text { text: preference.label; font-family: Theme.ui-font; font-size: 14px; color: preference.tone <= 1 ? Theme.paper : Theme.ink; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
                    }
                }
                Rectangle {
                    height: ceil(AuxiliaryModel.stats-preferences.length / 3.0) * 28px;
                    for preference[index] in AuxiliaryModel.stats-preferences: Rectangle {
                        x: mod(index, 3) * (parent.width + 24px) / 3;
                        y: floor(index / 3.0) * 28px;
                        width: (parent.width - 48px) / 3;
                        height: 24px;
                        HorizontalLayout {
                            spacing: 8px;
                            Rectangle {
                                width: 16px;
                                height: 16px;
                                border-width: 1px;
                                border-color: Theme.ink;
                                background: preference.tone == 0 ? Theme.ink : preference.tone == 1 ? Theme.secondary : preference.tone == 2 ? Theme.line : preference.tone == 3 ? Theme.fill : Theme.paper;
                            }
                            Text { text: preference.label + " " + preference.percent + "%"; font-family: Theme.ui-font; font-size: 16px; color: Theme.ink; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                        }
                    }
                }
            }
        }
        if Theme.scribe: Rectangle { vertical-stretch: 1; }
    }
}

// One Settings row: the name on the left, its control on the right. Rows are
// one line high; switch and action rows invert while pressed.
component SettingItem inherits Rectangle {
    in property <SettingEntry> entry;
    callback action();
    callback choose(string);
    callback decrease();
    callback increase();
    property <length> indent: root.entry.nested ? (Theme.scribe ? 28px : 24px) : 0px;
    property <length> label-size: root.entry.nested ? (Theme.scribe ? 17px : 16px) : (Theme.scribe ? 18px : 17px);
    property <color> label-color: !root.entry.enabled ? Theme.muted : root.entry.nested ? Theme.secondary : Theme.ink;
    property <length> option-width: Theme.scribe
        ? (root.entry.options.length >= 4 ? 88px : 120px)
        : (root.entry.options.length >= 4 ? 72px : root.entry.options.length == 3 ? 100px : 96px);
    height: Theme.scribe ? 64px : 56px;
    background: Theme.paper;
    if root.entry.kind == "toggle": Rectangle {
        background: toggle-touch.pressed ? Theme.ink : Theme.paper;
        accessible-role: checkbox;
        accessible-label: root.entry.title;
        accessible-checkable: true;
        accessible-checked: root.entry.checked;
        accessible-enabled: root.entry.enabled;
        HorizontalLayout {
            padding-left: root.indent;
            spacing: 16px;
            Text { text: root.entry.title; font-family: Theme.ui-font; font-size: root.label-size; color: toggle-touch.pressed ? Theme.paper : root.label-color; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
            Rectangle {
                width: 48px;
                Rectangle {
                    x: 0px; y: (parent.height - 28px) / 2; width: 48px; height: 28px;
                    border-width: root.entry.enabled ? 2px : 0px; border-radius: 0px; border-color: Theme.ink;
                    background: root.entry.enabled && root.entry.checked ? Theme.ink : Theme.paper;
                    if !root.entry.enabled: DashedOutline { x: 0px; y: 0px; width: parent.width; height: parent.height; radius: 0px; }
                    Rectangle { x: root.entry.checked ? 24px : 4px; y: 4px; width: 20px; height: 20px; border-radius: 0px; border-width: root.entry.enabled ? 0px : 2px; border-color: Theme.line; background: !root.entry.enabled ? Theme.paper : root.entry.checked ? Theme.paper : Theme.ink; }
                }
            }
        }
        toggle-touch := PressArea { enabled: root.entry.enabled; clicked => { root.action(); } }
    }
    if root.entry.kind == "choice": HorizontalLayout {
        padding-left: root.indent;
        spacing: 16px;
        Text { text: root.entry.title; font-family: Theme.ui-font; font-size: root.label-size; color: root.label-color; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
        Rectangle {
            width: root.option-width * root.entry.options.length;
            SegmentedControl {
                x: 0px; y: (parent.height - 48px) / 2; width: parent.width;
                options: root.entry.options;
                value: root.entry.selected-value;
                enabled: root.entry.enabled;
                chosen(value) => { root.choose(value); }
            }
        }
    }
    if root.entry.kind == "stepper": HorizontalLayout {
        padding-left: root.indent;
        spacing: 0px;
        Text { text: root.entry.title; font-family: Theme.ui-font; font-size: root.label-size; color: root.label-color; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
        Rectangle {
            width: 48px;
            ActionButton { x: 0px; y: (parent.height - 48px) / 2; width: 48px; height: 48px; text: "−"; accessible-label: root.entry.title + " " + Strings.decrease; enabled: root.entry.enabled; clicked => { root.decrease(); } }
        }
        Text { text: root.entry.value; width: Theme.scribe ? 72px : 56px; font-family: Theme.ui-font; font-size: 19px; font-weight: 700; color: root.entry.enabled ? Theme.ink : Theme.muted; horizontal-alignment: center; vertical-alignment: center; }
        Rectangle {
            width: 48px;
            ActionButton { x: 0px; y: (parent.height - 48px) / 2; width: 48px; height: 48px; text: "+"; accessible-label: root.entry.title + " " + Strings.increase; enabled: root.entry.enabled; clicked => { root.increase(); } }
        }
    }
    if root.entry.kind == "action": Rectangle {
        background: action-touch.pressed ? Theme.ink : Theme.paper;
        accessible-role: button;
        accessible-label: root.entry.title + " " + root.entry.value;
        accessible-enabled: root.entry.enabled;
        HorizontalLayout {
            padding-left: root.indent;
            spacing: 8px;
            Text { text: root.entry.title; font-family: Theme.ui-font; font-size: root.label-size; color: action-touch.pressed ? Theme.paper : root.label-color; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
            Text { text: root.entry.value; font-family: Theme.ui-font; font-size: 16px; color: action-touch.pressed ? Theme.paper : Theme.secondary; vertical-alignment: center; horizontal-stretch: 0; }
            Rectangle {
                width: 24px;
                Icon { x: 0px; y: (parent.height - 24px) / 2; kind: "next"; inverted: action-touch.pressed; }
            }
        }
        action-touch := PressArea { enabled: root.entry.enabled; clicked => { root.action(); } }
    }
    Rectangle { x: 0px; y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.fill; }
}

component SettingsTab inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked();
    property <bool> inverted: touch.pressed && !root.selected;
    background: root.inverted ? Theme.ink : Theme.paper;
    accessible-role: tab;
    accessible-label: root.text;
    accessible-item-selected: root.selected;
    Text { text: root.text; font-family: Theme.ui-font; font-size: Theme.scribe ? 19px : 18px; font-weight: root.selected ? 700 : 400; color: root.inverted ? Theme.paper : root.selected ? Theme.ink : Theme.secondary; horizontal-alignment: center; vertical-alignment: center; }
    if root.selected: Rectangle { x: 0px; y: parent.height - 4px; width: parent.width; height: 4px; background: Theme.ink; }
    touch := PressArea { enabled: !root.selected; clicked => { root.clicked(); } }
}

// "我的": the account, four tabs of settings, and the exit actions. The page
// title is left out because the bottom navigation already names it. Each tab
// fits one screen, so the page never pages; switching tabs redraws only the
// rows below the tab bar.
export component SettingsScreen inherits Rectangle {
    background: Theme.paper;
    VerticalLayout {
        width: root.width;
        height: root.height;
        spacing: 0px;
        Rectangle {
            height: Theme.scribe ? 112px : 96px;
            HorizontalLayout {
                padding-left: Theme.page-margin;
                padding-right: Theme.page-margin;
                spacing: Theme.scribe ? 20px : 16px;
                Rectangle {
                    width: Theme.scribe ? 64px : 52px;
                    Rectangle {
                        x: 0px; y: (parent.height - self.height) / 2;
                        width: parent.width; height: parent.width;
                        border-radius: self.width / 2;
                        background: Theme.ink;
                        Text { text: AuxiliaryModel.settings-account-initial; font-family: Theme.serif-font; font-size: Theme.scribe ? 26px : 22px; font-weight: 700; color: Theme.paper; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
                Text { text: AuxiliaryModel.settings-account-name; font-family: Theme.serif-font; font-size: Theme.scribe ? 28px : 24px; font-weight: 700; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                Rectangle {
                    width: 96px;
                    ActionButton { x: 0px; y: (parent.height - 48px) / 2; width: parent.width; height: 48px; text: Strings.renew; clicked => { AuxiliaryModel.event("settings.renew", ""); } }
                }
            }
        }
        Rectangle {
            height: Theme.scribe ? 56px : 52px;
            Rectangle { x: Theme.page-margin; y: parent.height - 1px; width: parent.width - Theme.page-margin * 2; height: 1px; background: Theme.line; }
            HorizontalLayout {
                padding-left: Theme.page-margin;
                padding-right: Theme.page-margin;
                spacing: 0px;
                for group in AuxiliaryModel.settings-groups: SettingsTab {
                    horizontal-stretch: 1;
                    text: group.title;
                    selected: group.id == AuxiliaryModel.settings-subpage;
                    clicked => { AuxiliaryModel.event("settings.open", group.id); }
                }
            }
        }
        Rectangle {
            vertical-stretch: 1;
            clip: true;
            VerticalLayout {
                padding-top: 8px;
                padding-left: Theme.page-margin;
                padding-right: Theme.page-margin;
                spacing: 0px;
                alignment: start;
                for entry in AuxiliaryModel.settings-rows: SettingItem {
                    entry: entry;
                    action => { AuxiliaryModel.event(entry.kind == "toggle" ? "settings.toggle" : "settings.action", entry.id); }
                    choose(value) => { AuxiliaryModel.event("settings.choice", entry.id + ":" + value); }
                    decrease => { AuxiliaryModel.event("settings.decrease", entry.id); }
                    increase => { AuxiliaryModel.event("settings.increase", entry.id); }
                }
                if AuxiliaryModel.settings-status != "": Text {
                    height: 48px;
                    text: AuxiliaryModel.settings-status;
                    font-family: Theme.ui-font;
                    font-size: 14px;
                    color: Theme.secondary;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
        Rectangle {
            height: Theme.settings-footer-height;
            Rectangle { x: Theme.page-margin; y: 0px; width: parent.width - Theme.page-margin * 2; height: 1px; background: Theme.line; }
            ActionButton {
                x: Theme.page-margin; y: (parent.height - 48px) / 2; width: 112px; height: 48px;
                text: Strings.logout; quiet: true;
                enabled: AuxiliaryModel.settings-account-active;
                clicked => { AuxiliaryModel.event("settings.logout", ""); }
            }
            ActionButton {
                x: parent.width - Theme.page-margin - self.width; y: (parent.height - 48px) / 2; width: 128px; height: 48px;
                text: Strings.exit-app;
                clicked => { AuxiliaryModel.event("settings.exit", ""); }
            }
        }
    }
}
