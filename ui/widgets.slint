import { Theme } from "theme.slint";
import { Strings } from "strings.slint";

export component Icon inherits Image {
    in property <string> kind;
    in property <bool> inverted;
    in property <bool> enabled: true;
    width: 24px;
    height: 24px;
    image-fit: contain;
    colorize: !root.enabled ? Theme.muted : root.inverted ? Theme.paper : Theme.ink;
    source: root.kind == "book" ? @image-url("../assets/icons/book.svg") :
        root.kind == "publication" ? @image-url("../assets/icons/publication.svg") :
        root.kind == "stats" ? @image-url("../assets/icons/stats.svg") :
        root.kind == "user" ? @image-url("../assets/icons/user.svg") :
        root.kind == "search" ? @image-url("../assets/icons/search.svg") :
        root.kind == "sync" ? @image-url("../assets/icons/sync.svg") :
        root.kind == "list" ? @image-url("../assets/icons/list.svg") :
        root.kind == "grid" ? @image-url("../assets/icons/grid.svg") :
        root.kind == "select" ? @image-url("../assets/icons/select.svg") :
        root.kind == "download" ? @image-url("../assets/icons/download.svg") :
        root.kind == "back" ? @image-url("../assets/icons/back.svg") :
        root.kind == "next" ? @image-url("../assets/icons/next.svg") :
        root.kind == "close" ? @image-url("../assets/icons/close.svg") :
        root.kind == "bookmark" ? @image-url("../assets/icons/bookmark.svg") :
        root.kind == "light" ? @image-url("../assets/icons/light.svg") :
        root.kind == "notes" ? @image-url("../assets/icons/notes.svg") :
        root.kind == "wifi" ? @image-url("../assets/icons/wifi.svg") :
        root.kind == "battery" ? @image-url("../assets/icons/battery.svg") :
        root.kind == "check" ? @image-url("../assets/icons/check.svg") :
        root.kind == "more" ? @image-url("../assets/icons/more.svg") :
        root.kind == "picture" ? @image-url("../assets/icons/picture.svg") :
        root.kind == "phone" ? @image-url("../assets/icons/phone.svg") :
        root.kind == "star" ? @image-url("../assets/icons/star.svg") :
        @image-url("../assets/icons/book.svg");
}

component DashedRule inherits Rectangle {
    in property <color> line-color: Theme.line;
    in property <length> stroke: 2px;
    in property <bool> vertical;
    property <int> count: ceil((root.vertical ? root.height : root.width) / 10px);
    background: transparent;
    clip: true;
    for index in root.count: Rectangle {
        x: root.vertical ? 0px : index * 10px;
        y: root.vertical ? index * 10px : 0px;
        width: root.vertical ? root.stroke : 6px;
        height: root.vertical ? 6px : root.stroke;
        background: root.line-color;
    }
}

export component DashedOutline inherits Rectangle {
    in property <color> stroke-color: Theme.line;
    in property <length> stroke: 2px;
    in property <length> radius: 6px;
    background: transparent;
    clip: true;
    DashedRule { x: root.radius / 2; y: 0px; width: root.width - root.radius; height: root.stroke; line-color: root.stroke-color; stroke: root.stroke; }
    DashedRule { x: root.radius / 2; y: root.height - root.stroke; width: root.width - root.radius; height: root.stroke; line-color: root.stroke-color; stroke: root.stroke; }
    DashedRule { x: 0px; y: root.radius / 2; width: root.stroke; height: root.height - root.radius; line-color: root.stroke-color; stroke: root.stroke; vertical: true; }
    DashedRule { x: root.width - root.stroke; y: root.radius / 2; width: root.stroke; height: root.height - root.radius; line-color: root.stroke-color; stroke: root.stroke; vertical: true; }
}

export component SwipeTouchArea inherits TouchArea {
    callback tapped();
    callback swiped(int);
    property <length> start-x;
    property <length> start-y;
    property <bool> suppress-click;
    pointer-event(event) => {
        if event.kind == PointerEventKind.down {
            root.start-x = self.mouse-x;
            root.start-y = self.mouse-y;
            root.suppress-click = false;
            Theme.refresh("press");
        }
        if event.kind == PointerEventKind.up {
            if abs(self.mouse-x - root.start-x) >= 64px && abs(self.mouse-x - root.start-x) > abs(self.mouse-y - root.start-y) {
                root.suppress-click = true;
                root.swiped(self.mouse-x < root.start-x ? 1 : -1);
            } else if abs(self.mouse-y - root.start-y) >= 64px {
                root.suppress-click = true;
            }
            Theme.refresh("release");
        }
    }
    clicked => { if !root.suppress-click && abs(self.mouse-x - root.start-x) < 64px && abs(self.mouse-y - root.start-y) < 64px { root.tapped(); } }
}

export component ActionButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> quiet: false;
    in property <bool> enabled: true;
    in property <bool> selected: false;
    in property <length> text-size: 18px;
    callback clicked();
    preferred-width: max(48px, label.preferred-width + 28px);
    min-width: 48px;
    height: 48px;
    border-radius: 6px;
    border-width: root.quiet || !root.enabled ? 0px : 2px;
    border-color: root.enabled ? Theme.ink : Theme.line;
    background: root.enabled && (root.primary || root.selected || touch.pressed) ? Theme.ink : Theme.paper;
    if !root.enabled && !root.quiet: DashedOutline { x: 0px; y: 0px; width: parent.width; height: parent.height; }
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    label := Text {
        text: root.text;
        color: !root.enabled ? Theme.muted : (root.primary || root.selected || touch.pressed) ? Theme.paper : Theme.ink;
        font-family: Theme.ui-font;
        font-size: root.text-size;
        font-weight: root.primary || root.selected ? 700 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
    touch := TouchArea {
        enabled: root.enabled;
        pointer-event(event) => { if event.kind == PointerEventKind.down { Theme.refresh("press"); } else if event.kind == PointerEventKind.up { Theme.refresh("release"); } }
        clicked => { root.clicked(); }
    }
}

export component IconButton inherits Rectangle {
    horizontal-stretch: 0;
    in property <string> icon;
    in property <string> text;
    in property <string> label: root.text;
    in property <bool> enabled: true;
    in property <bool> selected: false;
    callback clicked();
    min-width: 48px;
    preferred-width: root.text == "" ? 48px : caption.preferred-width + 56px;
    max-width: root.text == "" ? 48px : max(48px, caption.preferred-width + 56px);
    height: 48px;
    border-radius: 6px;
    background: root.enabled && (touch.pressed || root.selected) ? Theme.ink : Theme.paper;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: root.text == "" ? 0px : 8px;
        alignment: center;
        Rectangle { width: 24px; Icon { x: 0px; y: (parent.height - 24px) / 2; kind: root.icon; enabled: root.enabled; inverted: root.enabled && (touch.pressed || root.selected); } }
        caption := Text {
            text: root.text;
            font-family: Theme.ui-font;
            font-size: 17px;
            color: !root.enabled ? Theme.muted : (touch.pressed || root.selected) ? Theme.paper : Theme.ink;
            vertical-alignment: center;
        }
    }
    touch := TouchArea { enabled: root.enabled; pointer-event(event) => { if event.kind == PointerEventKind.down { Theme.refresh("press"); } else if event.kind == PointerEventKind.up { Theme.refresh("release"); } } clicked => { root.clicked(); } }
}

export component PageBar inherits Rectangle {
    in property <int> page: 1;
    in property <int> count: 1;
    callback turn(int);
    callback jump();
    height: 48px;
    HorizontalLayout {
        padding-left: Theme.page-margin;
        padding-right: Theme.page-margin;
        ActionButton { text: Strings.previous-page; quiet: true; enabled: root.page > 1; clicked => { root.turn(-1); } }
        Rectangle { horizontal-stretch: 1; }
        ActionButton { text: root.page + " / " + root.count; quiet: true; clicked => { root.jump(); } }
        Rectangle { horizontal-stretch: 1; }
        ActionButton { text: Strings.next-page; quiet: true; enabled: root.page < root.count; clicked => { root.turn(1); } }
    }
}

export component PageHeader inherits Rectangle {
    in property <string> title;
    in property <bool> more: false;
    in property <string> back-text;
    in property <bool> separator: true;
    callback back();
    callback menu();
    height: 52px;
    property <length> side-width: max(48px, back-action.preferred-width);
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        Rectangle { width: root.side-width; back-action := IconButton { x: 0px; icon: "back"; text: root.back-text; label: root.back-text == "" ? Strings.back : root.back-text; clicked => { root.back(); } } }
        Text { text: root.title; font-family: Theme.ui-font; font-size: 18px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; horizontal-stretch: 1; }
        Rectangle { width: root.side-width; if root.more: IconButton { x: parent.width - 48px; icon: "more"; label: Strings.more; clicked => { root.menu(); } } }
    }
    if root.separator: Rectangle { x: 0px; y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.line; }
}

export component ProgressTrack inherits Rectangle {
    in property <float> value: 0;
    height: 4px;
    background: Theme.fill;
    Rectangle { x: 0px; y: 0px; width: parent.width * clamp(root.value, 0, 1); height: parent.height; background: Theme.ink; }
}

export component ToggleRow inherits Rectangle {
    in property <string> text;
    in property <string> subtitle;
    in property <bool> checked;
    in property <bool> enabled: true;
    callback toggled();
    height: root.subtitle == "" ? 56px : 72px;
    border-width: 0px;
    background: touch.pressed && root.enabled ? Theme.ink : Theme.paper;
    accessible-role: checkbox;
    accessible-label: root.text;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-enabled: root.enabled;
    HorizontalLayout {
        padding-left: 8px; padding-right: 8px; spacing: 16px;
        VerticalLayout {
            alignment: center; spacing: 4px;
            Text { text: root.text; color: !root.enabled ? Theme.muted : touch.pressed ? Theme.paper : Theme.ink; font-family: Theme.ui-font; font-size: 18px; vertical-alignment: center; }
            if root.subtitle != "": Text { text: root.subtitle; color: touch.pressed ? Theme.paper : Theme.secondary; font-family: Theme.ui-font; font-size: 14px; }
        }
        Rectangle { horizontal-stretch: 1; }
        Rectangle {
            width: 48px;
            Rectangle {
                x: 0px; y: (parent.height - 28px) / 2; width: 48px; height: 28px; border-width: root.enabled ? 2px : 0px; border-radius: 14px; border-color: Theme.ink; background: root.enabled && root.checked ? Theme.ink : Theme.paper;
                if !root.enabled: DashedOutline { x: 0px; y: 0px; width: parent.width; height: parent.height; radius: 14px; }
                Rectangle { x: root.checked ? 24px : 4px; y: 4px; width: 20px; height: 20px; border-radius: 10px; border-width: root.enabled ? 0px : 2px; border-color: Theme.line; background: !root.enabled ? Theme.paper : root.checked ? Theme.paper : Theme.ink; }
            }
        }
    }
    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
    touch := TouchArea { enabled: root.enabled; pointer-event(event) => { if event.kind == PointerEventKind.down { Theme.refresh("press"); } else if event.kind == PointerEventKind.up { Theme.refresh("release"); } } clicked => { root.toggled(); } }
}

export component Choice inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    in property <bool> enabled: true;
    callback clicked();
    height: 48px;
    min-width: 48px;
    preferred-width: label.preferred-width + 24px;
    border-width: root.enabled ? 2px : 0px;
    border-color: Theme.ink;
    border-radius: 6px;
    background: root.enabled && (root.selected || touch.pressed) ? Theme.ink : Theme.paper;
    if !root.enabled: DashedOutline { x: 0px; y: 0px; width: parent.width; height: parent.height; }
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    label := Text { text: root.text; color: !root.enabled ? Theme.muted : root.selected || touch.pressed ? Theme.paper : Theme.ink; font-family: Theme.ui-font; font-size: 16px; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
    touch := TouchArea { enabled: root.enabled; pointer-event(event) => { if event.kind == PointerEventKind.down { Theme.refresh("press"); } else if event.kind == PointerEventKind.up { Theme.refresh("release"); } } clicked => { root.clicked(); } }
}

export component FilterChip inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    in property <bool> enabled: true;
    in property <length> text-size: 16px;
    in property <length> horizontal-padding: 16px;
    callback clicked();
    min-width: 48px;
    preferred-width: max(48px, caption.preferred-width + root.horizontal-padding * 2);
    max-width: max(48px, caption.preferred-width + root.horizontal-padding * 2);
    height: 48px;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    Rectangle {
        x: 0px; y: 6px; width: parent.width; height: 36px;
        border-width: root.enabled ? 1px : 0px; border-color: Theme.ink; border-radius: 18px;
        background: root.enabled && (root.selected || touch.pressed) ? Theme.ink : Theme.paper;
        if !root.enabled: DashedOutline { x: 0px; y: 0px; width: parent.width; height: parent.height; radius: 18px; }
        caption := Text { x: 0px; y: 0px; width: parent.width; height: parent.height; text: root.text; font-family: Theme.ui-font; font-size: root.text-size; font-weight: root.selected ? 700 : 400; color: !root.enabled ? Theme.muted : root.selected || touch.pressed ? Theme.paper : Theme.ink; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
    }
    touch := TouchArea { enabled: root.enabled; pointer-event(event) => { if event.kind == PointerEventKind.down { Theme.refresh("press"); } else if event.kind == PointerEventKind.up { Theme.refresh("release"); } } clicked => { root.clicked(); } }
}

export struct SegmentedOption { id: string, label: string }

export component SegmentedControl inherits Rectangle {
    in property <[SegmentedOption]> options;
    in property <string> value;
    in property <bool> enabled: true;
    in property <length> radius: 6px;
    callback chosen(string);
    height: 48px;
    min-width: root.options.length * 48px;
    border-radius: root.radius;
    background: Theme.paper;
    clip: true;
    HorizontalLayout {
        spacing: 0px;
        for option[index] in root.options: Rectangle {
            min-width: 48px; horizontal-stretch: 1;
            property <color> fill: root.enabled && (root.value == option.id || touch.pressed) ? Theme.ink : Theme.paper;
            background: transparent;
            Rectangle { x: 0px; y: 0px; width: parent.width; height: parent.height; border-radius: index == 0 || index == root.options.length - 1 ? root.radius : 0px; background: parent.fill; }
            if root.options.length > 1 && (index == 0 || index == root.options.length - 1): Rectangle { x: index == 0 ? parent.width / 2 : 0px; y: 0px; width: parent.width / 2; height: parent.height; background: parent.fill; }
            Text { text: option.label; font-family: Theme.ui-font; font-size: 16px; font-weight: root.value == option.id ? 700 : 400; color: !root.enabled ? Theme.muted : root.value == option.id || touch.pressed ? Theme.paper : Theme.ink; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
            if index > 0: Rectangle { x: 0px; y: 0px; width: 1px; height: parent.height; background: root.enabled ? Theme.ink : Theme.line; }
            touch := TouchArea { enabled: root.enabled; clicked => { root.chosen(option.id); } }
        }
    }
    if root.enabled: Rectangle { x: 0px; y: 0px; width: parent.width; height: parent.height; background: transparent; border-width: 2px; border-color: Theme.ink; border-radius: root.radius; }
    if !root.enabled: DashedOutline { x: 0px; y: 0px; width: parent.width; height: parent.height; }
}

export component ScaleControl inherits Rectangle {
    in property <[int]> values;
    in property <int> value;
    in property <bool> enabled: true;
    in property <string> label;
    in property <string> small-label: "A";
    in property <string> large-label: "A";
    in property <bool> segments;
    callback chosen(int);
    callback step(int);
    height: 56px;
    HorizontalLayout {
        spacing: 8px;
        ActionButton { text: root.small-label; text-size: 16px; enabled: root.enabled; quiet: true; clicked => { root.step(-1); } }
        track := Rectangle {
            horizontal-stretch: 1; min-width: 96px; height: 48px;
            accessible-role: slider; accessible-label: root.label; accessible-enabled: root.enabled;
            if !root.segments: Rectangle { x: 0px; y: 0px; width: parent.width; height: 48px; border-width: 1px; border-color: root.enabled ? Theme.ink : Theme.line; border-radius: 24px; background: Theme.paper; }
            for option[index] in root.values: Rectangle {
                x: root.segments ? (index - 1) * parent.width / max(1, root.values.length - 1) + 1px : 24px + index * (parent.width - 48px) / max(1, root.values.length - 1) - (Theme.scribe ? 3.5px : 3px);
                y: root.segments ? 14px : (Theme.scribe ? 20.5px : 21px);
                width: root.segments ? max(1px, parent.width / max(1, root.values.length - 1) - 3px) : Theme.scribe ? 7px : 6px;
                height: root.segments ? 20px : Theme.scribe ? 7px : 6px;
                border-radius: root.segments ? 1px : 5px;
                background: root.segments ? root.enabled && option <= root.value ? Theme.ink : Theme.paper : root.enabled && option < root.value ? Theme.ink : Theme.line;
                border-width: root.segments ? 1px : 0px; border-color: root.enabled ? Theme.ink : Theme.line;
                visible: !root.segments || index > 0;
            }
            for option[index] in root.values: Rectangle {
                x: 24px + index * (parent.width - 48px) / max(1, root.values.length - 1) - (Theme.scribe ? 23px : 20px);
                y: Theme.scribe ? 1px : 4px; width: Theme.scribe ? 46px : 40px; height: Theme.scribe ? 46px : 40px; border-radius: Theme.scribe ? 23px : 20px;
                visible: !root.segments && option == root.value;
                background: root.enabled ? Theme.ink : Theme.fill;
                Text { text: "" + root.value; color: root.enabled ? Theme.paper : Theme.muted; font-family: Theme.ui-font; font-size: 18px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
            }
            TouchArea { enabled: root.enabled && root.values.length > 0; clicked => { root.chosen(root.values[clamp(round((root.segments ? self.mouse-x / max(1px, self.width) : (self.mouse-x - 24px) / max(1px, self.width - 48px)) * (root.values.length - 1)), 0, root.values.length - 1)]); } }
        }
        ActionButton { text: root.large-label; text-size: root.large-label == "A" ? 28px : 18px; enabled: root.enabled; quiet: true; clicked => { root.step(1); } }
    }
}

export component RadioChoiceRow inherits Rectangle {
    in property <string> text;
    in property <string> description;
    in property <bool> selected;
    in property <bool> enabled: true;
    callback clicked();
    height: 56px;
    background: touch.pressed && root.enabled ? Theme.ink : Theme.paper;
    accessible-role: checkbox; accessible-label: root.text; accessible-checkable: true; accessible-checked: root.selected; accessible-enabled: root.enabled;
    HorizontalLayout {
        spacing: 12px; padding-left: 8px; padding-right: 8px;
        Rectangle { width: 24px; Rectangle { x: 0px; y: (parent.height - 24px) / 2; width: 24px; height: 24px; border-width: 2px; border-radius: 12px; border-color: root.enabled ? touch.pressed ? Theme.paper : Theme.ink : Theme.line; background: transparent; if root.selected: Rectangle { x: 6px; y: 6px; width: 12px; height: 12px; border-radius: 6px; background: touch.pressed ? Theme.paper : root.enabled ? Theme.ink : Theme.line; } } }
        Text { text: root.text; font-family: Theme.ui-font; font-size: 18px; color: !root.enabled ? Theme.muted : touch.pressed ? Theme.paper : Theme.ink; vertical-alignment: center; horizontal-stretch: 1; }
        Text { text: root.description; font-family: Theme.ui-font; font-size: 14px; color: touch.pressed ? Theme.paper : Theme.secondary; vertical-alignment: center; }
    }
    Rectangle { x: 0px; y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.line; }
    touch := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
}
