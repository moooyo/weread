import { Theme } from "theme.slint";
import { Strings } from "strings.slint";
import { ActionButton, IconButton, Icon, PageBar, FilterChip, SwipeTouchArea, DashedOutline } from "widgets.slint";

export struct SearchResult {
    id: string,
    title: string,
    author: string,
    category: string,
    initial: string,
    on-shelf: bool,
    cover: image,
    tone: int,
}

export struct RecentSearchChip {
    text: string,
    x: float,
    width: float,
    row: int,
}

export global LoginModel {
    in-out property <string> step: "qr";
    in-out property <image> qr;
    in-out property <string> qr-label;
    in-out property <string> status;
    in-out property <string> code;
    in-out property <int> code-length;
    in-out property <[string]> digits: ["", "", "", ""];
    in-out property <string> api-key;
    in-out property <bool> busy: false;
    in-out property <bool> can-submit: false;
    in-out property <bool> skills-open: false;
    in-out property <image> skills-qr;
    callback event(string, string);
}

export global SearchModel {
    in-out property <string> query;
    in-out property <string> composition;
    in-out property <float> query-width;
    in-out property <float> composition-width;
    in-out property <[string]> candidates;
    in-out property <[string]> recent;
    in-out property <[RecentSearchChip]> recent-chips;
    in-out property <int> recent-rows;
    in-out property <[SearchResult]> results;
    in-out property <string> scope: "store";
    in-out property <string> purpose: "books";
    in-out property <bool> keyboard-visible: true;
    in-out property <bool> paste-ready: false;
    in-out property <string> language: "zh";
    in-out property <bool> caps: false;
    in-out property <int> page: 1;
    in-out property <int> page-count: 1;
    in-out property <string> status;
    callback event(string, string);
}

component KeyCap inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> special: false;
    in property <bool> selected: false;
    in property <bool> enabled: true;
    in property <length> text-size: 21px;
    in property <int> text-weight: root.primary || root.selected ? 700 : 400;
    callback clicked();
    min-width: 48px;
    height: 52px;
    horizontal-stretch: 1;
    background: root.enabled && (root.primary || root.selected || touch.pressed) ? Theme.ink : root.special ? Theme.fill : Theme.paper;
    border-width: root.enabled ? 2px : 0px;
    border-color: root.enabled ? Theme.ink : Theme.line;
    border-radius: 0px;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    Text {
        text: root.text;
        color: !root.enabled ? Theme.muted : root.primary || root.selected || touch.pressed ? Theme.paper : Theme.ink;
        font-family: Theme.ui-font;
        font-size: root.text-size;
        font-weight: root.text-weight;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
    if !root.enabled: DashedOutline { x: 0px; y: 0px; width: parent.width; height: parent.height; stroke-color: Theme.line; radius: parent.border-radius; }
    touch := TouchArea { enabled: root.enabled; pointer-event(event) => { if event.kind == PointerEventKind.down { Theme.refresh("press"); } else if event.kind == PointerEventKind.up { Theme.refresh("release"); } } clicked => { root.clicked(); } }
}

component ClipboardInput inherits TextInput {
    in property <int> paste-sequence;
    in property <int> caret-sequence;
    in property <bool> paste-active: true;
    in property <bool> paste-at-end: false;
    private property <int> applied-paste-sequence;
    private property <int> applied-caret-sequence;
    private property <bool> ready: false;
    init => {
        root.applied-paste-sequence = root.paste-sequence;
        root.applied-caret-sequence = root.caret-sequence;
        root.ready = true;
    }
    changed caret-sequence => {
        if root.ready && root.applied-caret-sequence != root.caret-sequence {
            root.applied-caret-sequence = root.caret-sequence;
            root.select-all();
            root.clear-selection();
        }
    }
    changed paste-sequence => {
        if root.ready && root.applied-paste-sequence != root.paste-sequence {
            root.applied-paste-sequence = root.paste-sequence;
            if root.paste-active && root.enabled && !root.read-only {
                root.focus();
                if root.paste-at-end {
                    root.select-all();
                    root.clear-selection();
                }
                root.paste();
            }
        }
    }
}

export component TouchKeyboard inherits Rectangle {
    in property <string> language: "zh";
    in property <bool> caps;
    in property <string> composition;
    in property <[string]> candidates;
    in property <string> action-label: Strings.search;
    in property <bool> api-key-mode: false;
    callback key(string);
    callback candidate(string);
    height: 300px;
    background: Theme.paper;
    Rectangle { x: 0px; y: 0px; width: parent.width; height: 2px; background: Theme.ink; }
    VerticalLayout {
        padding-left: Theme.scribe ? 16px : 6px;
        padding-right: Theme.scribe ? 16px : 6px;
        padding-top: 2px;
        padding-bottom: 8px;
        spacing: 8px;
        Rectangle {
            height: 48px;
            clip: true;
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: root.composition == "" ? root.language == "zh" ? Strings.pinyin : root.language == "numeric" ? "123" : "ABC" : root.composition;
                    min-width: Theme.scribe ? 80px : 60px;
                    preferred-width: Theme.scribe ? 80px : 60px;
                    max-width: 180px;
                    font-family: Theme.ui-font;
                    font-size: 16px;
                    color: Theme.secondary;
                    vertical-alignment: center;
                    overflow: elide;
                }
                IconButton {
                    icon: "back";
                    label: Strings.previous-page;
                    enabled: root.composition != "";
                    clicked => { root.key("candidate-prev"); }
                }
                Rectangle {
                    horizontal-stretch: 1;
                    min-width: root.candidates.length * 48px + max(0, root.candidates.length - 1) * 8px;
                    clip: true;
                    HorizontalLayout {
                        alignment: start;
                        spacing: 8px;
                        for candidate[index] in root.candidates: Rectangle {
                            horizontal-stretch: 0;
                            min-width: 48px;
                            preferred-width: max(48px, candidate-label.preferred-width + (Theme.scribe ? 44px : 28px));
                            height: 48px;
                            background: candidate-touch.pressed ? Theme.ink : Theme.paper;
                            accessible-role: button;
                            accessible-label: candidate;
                            Rectangle { x: 0px; y: 8px; width: 1px; height: parent.height - 16px; background: Theme.line; }
                            candidate-label := Text {
                                text: candidate;
                                font-family: Theme.ui-font;
                                font-size: Theme.scribe ? 23px : 20px;
                                font-weight: index == 0 ? 700 : 400;
                                color: candidate-touch.pressed ? Theme.paper : Theme.ink;
                                overflow: elide;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            candidate-touch := TouchArea {
                                pointer-event(event) => { if event.kind == PointerEventKind.down { Theme.refresh("press"); } else if event.kind == PointerEventKind.up { Theme.refresh("release"); } }
                                clicked => { root.candidate(candidate); }
                            }
                        }
                    }
                }
                IconButton {
                    icon: "next";
                    label: Strings.next-page;
                    enabled: root.composition != "";
                    clicked => { root.key("candidate-next"); }
                }
                KeyCap {
                    text: Strings.paste;
                    text-size: 16px;
                    height: 48px;
                    preferred-width: 48px;
                    horizontal-stretch: 0;
                    clicked => { root.key("paste"); }
                }
            }
            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
        }
        HorizontalLayout {
            height: 52px;
            spacing: 8px;
            for key in root.language == "numeric" ? ["1", "2", "3", "4", "5", "6", "7", "8", "9", "0"] : root.caps && root.language == "en" ? ["Q", "W", "E", "R", "T", "Y", "U", "I", "O", "P"] : ["q", "w", "e", "r", "t", "y", "u", "i", "o", "p"]: KeyCap {
                text: key;
                clicked => { root.key(key); }
            }
        }
        HorizontalLayout {
            height: 52px;
            padding-left: root.language == "numeric" ? 0px : Theme.scribe ? 46px : 28px;
            padding-right: root.language == "numeric" ? 0px : Theme.scribe ? 46px : 28px;
            spacing: 8px;
            for key in root.language == "numeric" ? ["@", "#", "$", "%", "&", "-", "+", "(", ")", "/"] : root.caps && root.language == "en" ? ["A", "S", "D", "F", "G", "H", "J", "K", "L"] : ["a", "s", "d", "f", "g", "h", "j", "k", "l"]: KeyCap {
                text: key;
                clicked => { root.key(key); }
            }
        }
        HorizontalLayout {
            height: 52px;
            spacing: 8px;
            KeyCap {
                text: "⇧";
                width: (parent.width - 64px) * 0.15;
                horizontal-stretch: 0;
                special: true;
                selected: root.caps;
                accessible-label: Strings.uppercase;
                clicked => { root.key("shift"); }
            }
            for key in root.language == "numeric" ? ["*", ":", ";", "!", "?", "_", "="] : root.caps && root.language == "en" ? ["Z", "X", "C", "V", "B", "N", "M"] : ["z", "x", "c", "v", "b", "n", "m"]: KeyCap {
                text: key;
                width: (parent.width - 64px) * 0.1;
                horizontal-stretch: 0;
                clicked => { root.key(key); }
            }
            KeyCap {
                text: "⌫";
                width: (parent.width - 64px) * 0.15;
                horizontal-stretch: 0;
                special: true;
                accessible-label: Strings.delete;
                clicked => { root.key("backspace"); }
            }
        }
        HorizontalLayout {
            height: 52px;
            spacing: 8px;
            KeyCap {
                text: root.language == "numeric" ? "ABC" : "123";
                width: (parent.width - 32px) * 1.3 / 9.6;
                horizontal-stretch: 0;
                text-size: 17px;
                special: true;
                accessible-label: Strings.numbers-symbols;
                clicked => { root.key("numeric"); }
            }
            KeyCap {
                text: root.api-key-mode ? "@" : root.language == "zh" ? Strings.chinese : Strings.english;
                width: (parent.width - 32px) * 1.3 / 9.6;
                horizontal-stretch: 0;
                text-size: 18px;
                special: true;
                accessible-label: root.api-key-mode ? "@" : Strings.language;
                clicked => { root.key(root.api-key-mode ? "@" : "language"); }
            }
            KeyCap {
                text: root.composition != "" && root.candidates.length > 0 ? Strings.select-candidate : Strings.space;
                text-size: 17px;
                width: (parent.width - 32px) * 4 / 9.6;
                horizontal-stretch: 0;
                clicked => { root.key("space"); }
            }
            KeyCap {
                text: root.language == "zh" && !root.api-key-mode ? Strings.chinese-period : ".";
                accessible-label: Strings.period;
                width: (parent.width - 32px) / 9.6;
                horizontal-stretch: 0;
                clicked => { root.key("period"); }
            }
            KeyCap {
                text: root.action-label;
                width: (parent.width - 32px) * 2 / 9.6;
                horizontal-stretch: 0;
                text-size: 18px;
                primary: true;
                clicked => { root.key("submit"); }
            }
        }
    }
}

component LoginSkillsStep inherits Rectangle {
    in property <int> number;
    in property <string> text;
    in property <length> number-width;
    out property <length> preferred-text-width: step-copy.preferred-width;
    height: max(Theme.scribe ? 32px : 29px, step-copy.preferred-height);
    Text {
        x: 0px; y: 0px; width: root.number-width; height: root.height;
        text: "" + root.number + "."; font-family: Theme.ui-font;
        font-size: Theme.scribe ? 20px : 18px; color: Theme.ink;
        vertical-alignment: top;
    }
    step-copy := Text {
        x: root.number-width + 8px; y: 0px;
        width: max(0px, root.width - self.x); height: self.preferred-height;
        text: root.text; font-family: Theme.ui-font;
        font-size: Theme.scribe ? 20px : 18px; color: Theme.ink;
        wrap: word-wrap; vertical-alignment: top;
    }
}

component LoginSkillsGuide inherits Rectangle {
    background: Theme.paper;
    clip: true;
    private property <length> safe-top: Theme.scribe ? 80px : 64px;
    private property <length> bottom-margin: Theme.scribe ? 32px : 20px;
    private property <length> column-width: max(0px, min(Theme.scribe ? 600px : 520px, root.width - Theme.page-margin * 2));
    private property <length> number-width: Theme.scribe ? 28px : 26px;
    private property <length> steps-width: min(root.column-width, max(max(step-one.preferred-text-width, step-two.preferred-text-width), max(step-three.preferred-text-width, step-four.preferred-text-width)) + root.number-width + 8px);
    private property <length> steps-height: step-one.height + step-two.height + step-three.height + step-four.height + 42px;
    private property <length> steps-offset: Theme.scribe ? 220px : 168px;
    private property <length> qr-size: max(0px, min(Theme.scribe ? 360px : 288px, min(root.column-width, root.height - root.safe-top - root.bottom-margin - root.steps-offset - root.steps-height)));
    private property <length> content-height: root.qr-size + root.steps-offset + root.steps-height;
    private property <length> content-top: clamp((Theme.scribe ? 190px : 94px) - 28px, root.safe-top, max(root.safe-top, root.height - root.bottom-margin - root.content-height));
    Text {
        x: (root.width - root.column-width) / 2; y: root.content-top;
        width: root.column-width; height: Theme.scribe ? 48px : 40px;
        text: Strings.login-skills-title; font-family: Theme.serif-font;
        font-size: Theme.scribe ? 32px : 26px; font-weight: 700;
        horizontal-alignment: center; vertical-alignment: center;
    }
    Text {
        x: (root.width - root.column-width) / 2;
        y: root.content-top + (Theme.scribe ? 66px : 56px);
        width: root.column-width; height: Theme.scribe ? 32px : 30px;
        text: Strings.login-skills-scan; font-family: Theme.ui-font;
        font-size: Theme.scribe ? 20px : 18px; color: Theme.secondary;
        horizontal-alignment: center; vertical-alignment: center;
        wrap: word-wrap; overflow: elide;
    }
    Rectangle {
        x: (root.width - root.qr-size) / 2;
        y: root.content-top + (Theme.scribe ? 120px : 100px);
        width: root.qr-size; height: root.qr-size; background: Theme.paper;
        if LoginModel.skills-qr.width > 0 && LoginModel.skills-qr.height > 0: Image {
            x: 0px; y: 0px; width: parent.width; height: parent.height;
            source: LoginModel.skills-qr; image-fit: contain;
            colorize: Theme.ink; image-rendering: pixelated;
            accessible-label: Strings.login-skills-scan;
        }
        if LoginModel.skills-qr.width <= 0 || LoginModel.skills-qr.height <= 0: Text {
            x: 12px; y: (parent.height - self.height) / 2;
            width: max(0px, parent.width - 24px); height: min(96px, parent.height);
            text: Strings.login-skills-qr-unavailable; font-family: Theme.ui-font;
            font-size: Theme.scribe ? 20px : 18px; color: Theme.secondary;
            horizontal-alignment: center; vertical-alignment: center;
            wrap: word-wrap; overflow: elide;
        }
    }
    Text {
        x: (root.width - root.column-width) / 2;
        y: root.content-top + root.qr-size + (Theme.scribe ? 148px : 120px);
        width: root.column-width; height: Theme.scribe ? 28px : 26px;
        text: Strings.login-skills-url; font-family: Theme.ui-font;
        font-size: Theme.scribe ? 18px : 16px; color: Theme.secondary;
        horizontal-alignment: center; vertical-alignment: center;
    }
    // Measure the widest copy once, then center the complete aligned group.
    Rectangle {
        x: (root.width - root.steps-width) / 2;
        y: root.content-top + root.qr-size + root.steps-offset;
        width: root.steps-width; height: root.steps-height;
        step-one := LoginSkillsStep {
            x: 0px; y: 0px; width: parent.width;
            number: 1; number-width: root.number-width; text: Strings.login-first-step;
        }
        step-two := LoginSkillsStep {
            x: 0px; y: step-one.y + step-one.height + 14px; width: parent.width;
            number: 2; number-width: root.number-width; text: Strings.login-second-step;
        }
        step-three := LoginSkillsStep {
            x: 0px; y: step-two.y + step-two.height + 14px; width: parent.width;
            number: 3; number-width: root.number-width; text: Strings.login-third-step;
        }
        step-four := LoginSkillsStep {
            x: 0px; y: step-three.y + step-three.height + 14px; width: parent.width;
            number: 4; number-width: root.number-width; text: Strings.login-fourth-step;
        }
    }
    ActionButton {
        x: Theme.page-margin; y: Theme.scribe ? 16px : 8px;
        width: 96px; height: 48px; quiet: true; text: Strings.back;
        clicked => { LoginModel.event("skills-back", ""); }
    }
}

export component LoginScreen inherits Rectangle {
    background: Theme.paper;
    clip: true;
    private property <length> safe-top: Theme.scribe ? 80px : 64px;
    private property <length> bottom-margin: Theme.scribe ? 32px : 20px;
    private property <length> available-height: max(0px, root.height - root.safe-top - root.bottom-margin);
    private property <length> column-width: max(0px, min(Theme.scribe ? 600px : 520px, root.width - Theme.page-margin * 2));
    private property <length> title-height: Theme.scribe ? 48px : 40px;
    private property <length> qr-chrome-height: Theme.scribe ? 412px : 364px;
    private property <length> qr-size: max(0px, min(Theme.scribe ? 480px : 360px, min(root.column-width, root.available-height - root.qr-chrome-height)));
    private property <length> qr-group-height: root.qr-size + root.qr-chrome-height;
    private property <length> qr-top: clamp((Theme.scribe ? 190px : 94px) - 28px, root.safe-top, max(root.safe-top, root.height - root.bottom-margin - root.qr-group-height));
    private property <length> qr-offset: Theme.scribe ? 120px : 100px;
    private property <bool> qr-expired: LoginModel.status == Strings.login-expired || LoginModel.qr-label == Strings.login-expired;
    private property <bool> qr-ready: LoginModel.qr.width > 0 && LoginModel.qr.height > 0 && !LoginModel.busy && !root.qr-expired && (LoginModel.status == "" || LoginModel.status == Strings.login-scan);
    private property <string> qr-message: root.qr-expired ? Strings.login-expired : LoginModel.busy ? Strings.login-connecting : LoginModel.status != "" && LoginModel.status != Strings.login-scan ? LoginModel.status : Strings.login-connecting;
    private property <string> qr-prompt: root.qr-expired ? Strings.login-refresh-hint : LoginModel.status == Strings.network-unavailable ? Strings.login-network-hint : Strings.login-scan;
    private property <bool> roomy-code: Theme.scribe && root.available-height >= 826px && root.column-width >= 520px;
    private property <length> code-width: min(root.column-width, root.roomy-code ? 520px : 380px);
    private property <length> code-body-height: root.roomy-code ? 714px : 500px;
    private property <length> code-title-gap: root.roomy-code ? 24px : 20px;
    private property <length> code-group-height: root.title-height + root.code-title-gap + root.code-body-height + 40px;
    private property <length> code-top: clamp(root.safe-top + (root.available-height - root.code-group-height) / 2 - (root.roomy-code ? 16px : 8px), root.safe-top, max(root.safe-top, root.height - root.bottom-margin - root.code-group-height));
    // Non-code states cannot reveal an alternative login method.
    if !LoginModel.skills-open && LoginModel.step != "code": Rectangle {
        x: (root.width - root.column-width) / 2; y: root.qr-top;
        width: root.column-width; height: root.qr-group-height;
        Text {
            x: 0px; y: 0px; width: parent.width; height: root.title-height;
            text: Strings.login-title; font-family: Theme.serif-font;
            font-size: Theme.scribe ? 32px : 26px; font-weight: 700;
            horizontal-alignment: center; vertical-alignment: center;
        }
        Text {
            x: 0px; y: Theme.scribe ? 66px : 56px;
            width: parent.width; height: Theme.scribe ? 32px : 30px;
            text: root.qr-prompt; font-family: Theme.ui-font;
            font-size: Theme.scribe ? 20px : 18px; font-weight: 400;
            color: Theme.secondary; horizontal-alignment: center; vertical-alignment: center;
        }
        Rectangle {
            x: (parent.width - root.qr-size) / 2; y: root.qr-offset;
            width: root.qr-size; height: root.qr-size; background: Theme.paper;
            if root.qr-ready: Image {
                x: 0px; y: 0px; width: parent.width; height: parent.height;
                source: LoginModel.qr; image-fit: contain;
                colorize: Theme.ink; image-rendering: pixelated;
                accessible-label: Strings.login-scan;
            }
            if !root.qr-ready: Rectangle {
                x: 12px; y: (parent.height - self.height) / 2;
                width: max(0px, parent.width - 24px); height: min(96px, parent.height);
                Text {
                    x: 0px; y: 0px; width: parent.width;
                    height: LoginModel.status == Strings.login-skill-required ? min(40px, parent.height) : parent.height;
                    text: root.qr-message; font-family: Theme.ui-font;
                    font-size: Theme.scribe ? 20px : 18px;
                    color: LoginModel.status == Strings.login-skill-required ? Theme.ink : Theme.secondary;
                    font-weight: LoginModel.status == Strings.login-skill-required ? 500 : 400;
                    horizontal-alignment: center; vertical-alignment: center;
                    wrap: word-wrap; overflow: elide;
                }
                if LoginModel.status == Strings.login-skill-required: Text {
                    x: 0px; y: 56px; width: parent.width; height: max(0px, parent.height - self.y);
                    text: Strings.login-skills-required-hint; font-family: Theme.ui-font;
                    font-size: 16px; color: Theme.secondary;
                    horizontal-alignment: center; vertical-alignment: center;
                    wrap: word-wrap; overflow: elide;
                }
            }
        }
        Text {
            x: 0px; y: root.qr-size + (Theme.scribe ? 140px : 112px);
            width: parent.width; height: 28px;
            text: root.qr-ready && LoginModel.qr-label != Strings.login-scan ? LoginModel.qr-label : "";
            font-family: Theme.ui-font; font-size: 16px; color: Theme.secondary;
            horizontal-alignment: center; vertical-alignment: center; overflow: elide;
        }
        ActionButton {
            x: (parent.width - self.width) / 2; y: root.qr-size + (Theme.scribe ? 182px : 154px);
            width: min(parent.width, Theme.scribe ? 256px : 200px); height: 48px;
            text: Strings.login-refresh; quiet: true; enabled: !LoginModel.busy;
            clicked => { LoginModel.event("refresh", ""); }
        }
        Rectangle {
            x: 0px; y: root.qr-size + (Theme.scribe ? 270px : 230px);
            width: parent.width; height: 1px; background: Theme.line;
        }
        Text {
            x: 0px; y: root.qr-size + (Theme.scribe ? 290px : 250px);
            width: parent.width; height: Theme.scribe ? 32px : 28px;
            text: Strings.login-skills-hint; font-family: Theme.ui-font;
            font-size: Theme.scribe ? 20px : 18px; font-weight: 500;
            horizontal-alignment: center; vertical-alignment: center;
            wrap: word-wrap; overflow: elide;
        }
        Text {
            x: 0px; y: root.qr-size + (Theme.scribe ? 330px : 284px);
            width: parent.width; height: Theme.scribe ? 28px : 26px;
            text: Strings.login-skills-url; font-family: Theme.ui-font;
            font-size: Theme.scribe ? 18px : 16px; color: Theme.secondary;
            horizontal-alignment: center; vertical-alignment: center;
        }
        ActionButton {
            x: (parent.width - self.width) / 2; y: root.qr-size + (Theme.scribe ? 364px : 316px);
            width: min(parent.width, 256px); height: 48px;
            text: Strings.login-skills-help; quiet: true;
            clicked => { LoginModel.event("skills-help", ""); }
        }
    }
        if !LoginModel.skills-open && LoginModel.step == "code": Rectangle {
            x: 0px; y: root.code-top; width: root.width; height: root.code-group-height;
            Text {
                x: 0px; y: 0px; width: parent.width; height: root.title-height;
                text: Strings.login-title; font-family: Theme.serif-font;
                font-size: Theme.scribe ? 32px : 26px; font-weight: 700;
                horizontal-alignment: center; vertical-alignment: center;
            }
            Rectangle {
                x: (parent.width - self.width) / 2;
                y: root.title-height + root.code-title-gap;
                width: root.code-width;
                height: root.code-body-height;
            VerticalLayout {
                x: 0px; y: 0px; width: parent.width; height: parent.height;
                spacing: 0px;
                HorizontalLayout {
                    height: root.roomy-code ? 40px : 28px;
                    alignment: center;
                    spacing: root.roomy-code ? 10px : 8px;
                    Rectangle {
                        width: root.roomy-code ? 30px : 22px;
                        Icon {
                            y: (parent.height - self.height) / 2;
                            kind: "check";
                            width: root.roomy-code ? 30px : 22px;
                            height: self.width;
                        }
                    }
                    Text {
                        text: Strings.login-confirmed;
                        horizontal-stretch: 0;
                        font-family: Theme.ui-font;
                        font-size: root.roomy-code ? 28px : 19px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }
                Rectangle { height: root.roomy-code ? 8px : 6px; }
                Text {
                    text: Strings.login-code-hint;
                    font-family: Theme.ui-font;
                    font-size: root.roomy-code ? 19px : 16px;
                    color: Theme.secondary;
                    height: root.roomy-code ? 28px : 24px;
                    horizontal-alignment: center;
                }
                Rectangle { height: root.roomy-code ? 36px : 18px; }
                HorizontalLayout {
                    alignment: center;
                    spacing: root.roomy-code ? 22px : 16px;
                    height: root.roomy-code ? 124px : 80px;
                    for digit[index] in LoginModel.digits: Rectangle {
                        width: min(root.roomy-code ? 104px : 72px, max(0px, (root.code-width - (root.roomy-code ? 66px : 48px)) / 4));
                        height: root.roomy-code ? 124px : 80px;
                        border-width: index == LoginModel.code-length ? 3px : 2px;
                        border-color: index <= LoginModel.code-length ? Theme.ink : Theme.line;
                        border-radius: 0px;
                        Text {
                            text: digit;
                            font-family: Theme.serif-font;
                            font-size: root.roomy-code ? 58px : 38px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
                Rectangle { height: root.roomy-code ? 40px : 18px; }
                VerticalLayout {
                    spacing: root.roomy-code ? 14px : 10px;
                    height: root.roomy-code ? 362px : 262px;
                    for row in [0, 1, 2]: HorizontalLayout {
                        spacing: root.roomy-code ? 14px : 10px;
                        for column in [0, 1, 2]: KeyCap {
                            height: root.roomy-code ? 80px : 58px;
                            border-radius: 0px;
                            text: "" + (row * 3 + column + 1);
                            text-size: root.roomy-code ? 30px : 24px;
                            text-weight: 500;
                            enabled: !LoginModel.busy;
                            clicked => { LoginModel.event("code-key", "" + (row * 3 + column + 1)); }
                        }
                    }
                    HorizontalLayout {
                        spacing: root.roomy-code ? 14px : 10px;
                        KeyCap {
                            height: root.roomy-code ? 80px : 58px;
                            border-radius: 0px;
                            text: Strings.login-retry;
                            text-size: root.roomy-code ? 19px : 16px;
                            text-weight: 500;
                            enabled: !LoginModel.busy;
                            clicked => { LoginModel.event("code-key", "rescan"); }
                        }
                        KeyCap {
                            height: root.roomy-code ? 80px : 58px;
                            border-radius: 0px;
                            text: "0";
                            text-size: root.roomy-code ? 30px : 24px;
                            text-weight: 500;
                            enabled: !LoginModel.busy;
                            clicked => { LoginModel.event("code-key", "0"); }
                        }
                        KeyCap {
                            height: root.roomy-code ? 80px : 58px;
                            border-radius: 0px;
                            text: "⌫";
                            text-size: root.roomy-code ? 30px : 24px;
                            text-weight: 500;
                            accessible-label: Strings.delete;
                            enabled: !LoginModel.busy;
                            clicked => { LoginModel.event("code-key", "backspace"); }
                        }
                    }
                }
                Rectangle { height: root.roomy-code ? 28px : 16px; }
                ActionButton {
                    text: Strings.login-submit;
                    primary: true;
                    enabled: LoginModel.can-submit && !LoginModel.busy;
                    clicked => { LoginModel.event("submit-code", ""); }
                }
            }
            }
            Text {
                x: (parent.width - root.code-width) / 2;
                y: root.title-height + root.code-title-gap + root.code-body-height + 12px;
                width: root.code-width; height: 28px;
                text: LoginModel.status != Strings.login-code-hint ? LoginModel.status : "";
                font-family: Theme.ui-font; font-size: 14px; color: Theme.secondary;
                horizontal-alignment: center; vertical-alignment: center; overflow: elide;
            }
        }
    if LoginModel.skills-open: LoginSkillsGuide {
        x: 0px; y: 0px; width: root.width; height: root.height;
    }
    IconButton {
        x: root.width - Theme.page-margin - self.width;
        y: Theme.scribe ? 16px : 8px;
        width: Theme.touch-size;
        height: Theme.touch-size;
        icon: "close";
        label: Strings.exit-app;
        clicked => { LoginModel.event("close", ""); }
    }
}

component SearchBookRow inherits Rectangle {
    in property <SearchResult> book;
    callback open();
    callback add();
    callback turn(int);
    height: 72px;
    HorizontalLayout {
        spacing: 14px;
        Rectangle {
            horizontal-stretch: 1;
            background: touch.pressed ? Theme.ink : Theme.paper;
            accessible-role: button;
            accessible-label: root.book.title;
            HorizontalLayout {
                spacing: 14px;
                Rectangle {
                    width: 40px; height: 56px;
                    background: root.book.tone == 0 ? Theme.ink : root.book.tone == 1 ? Theme.secondary : root.book.tone == 2 ? Theme.fill : Theme.paper;
                    border-width: root.book.tone == 3 ? 1px : 0px;
                    border-color: Theme.ink;
                    border-radius: 0px;
                    Text {
                        text: root.book.initial;
                        color: root.book.tone < 2 ? Theme.paper : Theme.ink;
                        font-family: Theme.serif-font;
                        font-size: 19px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    Image { source: root.book.cover; image-fit: cover; }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 4px;
                    Text {
                        text: root.book.title;
                        color: touch.pressed ? Theme.paper : Theme.ink;
                        font-family: Theme.ui-font;
                        font-size: 18px;
                        font-weight: 500;
                        overflow: elide;
                        height: 28px;
                    }
                    Text {
                        text: root.book.author + (root.book.category == "" ? "" : " · " + root.book.category);
                        color: touch.pressed ? Theme.paper : Theme.secondary;
                        font-family: Theme.ui-font;
                        font-size: 14px;
                        overflow: elide;
                        height: 20px;
                    }
                }
            }
            touch := SwipeTouchArea {
                tapped => { root.open(); }
                swiped(direction) => { root.turn(direction); }
            }
        }
        if root.book.on-shelf: Rectangle {
            width: 100px;
            height: 48px;
            HorizontalLayout {
                spacing: 4px;
                Icon { kind: "check"; width: 16px; height: 16px; }
                Text { text: Strings.on-shelf; font-family: Theme.ui-font; font-size: 14px; color: Theme.secondary; vertical-alignment: center; }
            }
        }
        if !root.book.on-shelf: ActionButton {
            text: Strings.add-to-shelf;
            clicked => { root.add(); }
        }
    }
    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
}

export component SearchScreen inherits Rectangle {
    private property <int> paste-sequence;
    private property <int> caret-sequence;
    private property <bool> paste-at-end;
    background: Theme.paper;
    clip: true;
    VerticalLayout {
        spacing: 0px;
        Rectangle {
            height: 60px;
            HorizontalLayout {
                padding-left: Theme.page-margin;
                padding-right: 8px;
                spacing: 8px;
                if Theme.scribe || SearchModel.purpose != "books": IconButton { icon: "back"; label: Strings.back; clicked => { SearchModel.event("back", ""); } }
                if SearchModel.purpose == "thought": Text {
                    text: Strings.write-thought;
                    font-family: Theme.serif-font;
                    font-size: 24px;
                    font-weight: 700;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                if SearchModel.purpose != "thought": Rectangle {
                    height: 48px;
                    horizontal-stretch: 1;
                    border-width: SearchModel.keyboard-visible ? 3px : 2px;
                    border-color: Theme.ink;
                    border-radius: 0px;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 8px;
                        spacing: 10px;
                        Rectangle { width: 24px; Icon { x: 0px; y: (parent.height - 24px) / 2; kind: "search"; } }
                        inline-field := Rectangle {
                            horizontal-stretch: 1;
                            clip: true;
                            private property <length> composition-width: min(SearchModel.composition-width * 1px, max(0px, self.width - 3px));
                            private property <length> committed-width: min(SearchModel.query-width * 1px, max(0px, self.width - self.composition-width - 3px));
                            if SearchModel.query == "" && SearchModel.composition == "": Text {
                                text: SearchModel.purpose == "publications" ? Strings.publication-search : Strings.search-hint;
                                font-family: Theme.ui-font;
                                font-size: 18px;
                                color: Theme.muted;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            TouchArea {
                                clicked => { query-input.focus(); SearchModel.event("focus", ""); }
                            }
                            query-input := ClipboardInput {
                                x: 0px;
                                y: 0px;
                                width: SearchModel.composition == "" ? parent.width : max(1px, inline-field.committed-width);
                                height: parent.height;
                                text <=> SearchModel.query;
                                paste-sequence: root.paste-sequence;
                                caret-sequence: root.caret-sequence;
                                paste-active: SearchModel.purpose != "thought";
                                paste-at-end: root.paste-at-end;
                                font-family: Theme.ui-font;
                                font-size: 18px;
                                color: Theme.ink;
                                text-cursor-width: SearchModel.keyboard-visible && SearchModel.composition == "" ? 2px : 0px;
                                single-line: true;
                                vertical-alignment: center;
                                accessible-label: SearchModel.purpose == "publications" ? Strings.publication-search : Strings.search-hint;
                                edited => { SearchModel.event("edit-query", self.text); }
                                accepted => { SearchModel.event("key", "submit"); }
                                changed has-focus => {
                                    if self.has-focus { SearchModel.event("focus", ""); }
                                }
                            }
                            if SearchModel.composition != "": Rectangle {
                                x: inline-field.committed-width;
                                y: (parent.height - 28px) / 2;
                                width: inline-field.composition-width;
                                height: 28px;
                                Text {
                                    text: SearchModel.composition;
                                    font-family: Theme.ui-font;
                                    font-size: 18px;
                                    color: Theme.ink;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                Rectangle { x: 0px; y: 25px; width: parent.width; height: 1px; background: Theme.ink; }
                            }
                            if SearchModel.keyboard-visible && (SearchModel.composition != "" || !query-input.has-focus): Rectangle {
                                x: inline-field.committed-width + inline-field.composition-width + 1px;
                                y: (parent.height - self.height) / 2;
                                width: 2px;
                                height: Theme.scribe ? 28px : 24px;
                                background: Theme.ink;
                            }
                            TouchArea {
                                enabled: !SearchModel.keyboard-visible;
                                clicked => { query-input.focus(); SearchModel.event("focus", ""); }
                            }
                        }
                    }
                }
                if !SearchModel.keyboard-visible: ActionButton {
                    text: Strings.keyboard;
                    quiet: true;
                    clicked => { SearchModel.event("focus", ""); }
                }
                ActionButton {
                    text: Theme.scribe || SearchModel.purpose != "books" ? Strings.clear : Strings.cancel;
                    quiet: true;
                    clicked => { SearchModel.event(Theme.scribe || SearchModel.purpose != "books" ? "clear" : "back", ""); }
                }
            }
        }
        if SearchModel.purpose == "books": Rectangle {
            height: 48px;
            Rectangle { x: 0px; y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.line; }
            HorizontalLayout {
                padding-left: Theme.scribe ? Theme.page-margin : 0px;
                padding-right: Theme.scribe ? Theme.page-margin : 0px;
                spacing: Theme.scribe ? 32px : 0px;
                for scope[index] in [Strings.store, Strings.my-shelf]: Rectangle {
                    horizontal-stretch: Theme.scribe ? 0 : 1;
                    min-width: 48px;
                    preferred-width: Theme.scribe ? max(48px, scope-label.preferred-width + 8px) : 0px;
                    background: touch.pressed ? Theme.ink : Theme.paper;
                    property <bool> active: SearchModel.scope == (index == 0 ? "store" : "shelf");
                    accessible-role: button;
                    accessible-label: scope;
                    scope-label := Text {
                        text: scope;
                        font-family: Theme.ui-font;
                        font-size: 18px;
                        font-weight: parent.active ? 700 : 400;
                        color: touch.pressed ? Theme.paper : parent.active ? Theme.ink : Theme.secondary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    Rectangle { y: parent.height - (parent.active ? 3px : 1px); height: parent.active ? 3px : 1px; background: parent.active ? Theme.ink : Theme.line; }
                    touch := TouchArea { clicked => { SearchModel.event("scope", index == 0 ? "store" : "shelf"); } }
                }
                if Theme.scribe: Rectangle { horizontal-stretch: 1; }
            }
        }
        Rectangle {
            vertical-stretch: 1;
            clip: true;
            if SearchModel.purpose == "books" && SearchModel.query == "": VerticalLayout {
                padding-left: Theme.page-margin;
                padding-right: Theme.page-margin;
                padding-top: 16px;
                spacing: 12px;
                HorizontalLayout {
                    height: 48px;
                    Text { text: Strings.recent-searches; font-family: Theme.ui-font; font-size: 18px; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; }
                    ActionButton { text: Strings.clear-history; quiet: true; clicked => { SearchModel.event("clear-history", ""); } }
                }
                Rectangle {
                    height: max(0, SearchModel.recent-rows * 56 - 8) * 1px;
                    for chip in SearchModel.recent-chips: FilterChip {
                        text: chip.text;
                        text-size: Theme.scribe ? 18px : 16px;
                        horizontal-padding: Theme.scribe ? 20px : 16px;
                        width: chip.width * 1px;
                        x: chip.x * 1px;
                        y: chip.row * 56px;
                        clicked => { SearchModel.event("history", chip.text); }
                    }
                }
                Rectangle { vertical-stretch: 1; }
            }
            if SearchModel.purpose == "books" && SearchModel.query != "": VerticalLayout {
                padding-left: Theme.page-margin;
                padding-right: Theme.page-margin;
                spacing: 0px;
                Text {
                    height: 40px;
                    text: SearchModel.status;
                    font-family: Theme.ui-font;
                    font-size: 15px;
                    color: Theme.secondary;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Rectangle { height: 1px; background: Theme.line; }
                for book in SearchModel.results: SearchBookRow {
                    book: book;
                    open => { SearchModel.event("open", book.id); }
                    add => { SearchModel.event("add", book.id); }
                    turn(direction) => { SearchModel.event("page", "" + direction); }
                }
                if SearchModel.composition == "" && SearchModel.results.length == 0 && SearchModel.status != "" && SearchModel.status != Strings.searching: Text {
                    text: Strings.no-results;
                    font-family: Theme.ui-font;
                    font-size: 18px;
                    color: Theme.secondary;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                    height: 96px;
                }
                Rectangle { vertical-stretch: 1; }
            }
            if SearchModel.purpose == "publications": VerticalLayout {
                padding-left: Theme.page-margin;
                padding-right: Theme.page-margin;
                padding-top: 24px;
                spacing: 16px;
                Text {
                    text: Strings.publication-search;
                    font-family: Theme.serif-font;
                    font-size: 24px;
                    font-weight: 700;
                    height: 40px;
                }
                Text {
                    text: SearchModel.query + SearchModel.composition;
                    font-family: Theme.ui-font;
                    font-size: 24px;
                    color: Theme.secondary;
                    wrap: word-wrap;
                }
                Rectangle { vertical-stretch: 1; }
            }
            if SearchModel.purpose == "thought": Rectangle {
                x: Theme.page-margin;
                y: 12px;
                width: parent.width - Theme.page-margin * 2;
                height: parent.height - 24px;
                border-width: 1px;
                border-color: Theme.line;
                border-radius: 0px;
                if SearchModel.query == "": Text {
                    x: 16px; y: 16px; width: parent.width - 32px; height: parent.height - 32px;
                    text: Strings.write-thought;
                    font-family: Theme.ui-font;
                    font-size: 18px;
                    color: Theme.muted;
                }
                ClipboardInput {
                    x: 16px; y: 16px; width: parent.width - 32px; height: parent.height - 32px;
                    text <=> SearchModel.query;
                    paste-sequence: root.paste-sequence;
                    caret-sequence: root.caret-sequence;
                    paste-active: SearchModel.purpose == "thought";
                    paste-at-end: root.paste-at-end;
                    font-family: Theme.ui-font;
                    font-size: 18px;
                    color: Theme.ink;
                    single-line: false;
                    wrap: word-wrap;
                    accessible-label: Strings.write-thought;
                    edited => { SearchModel.event("edit-query", self.text); }
                }
            }
        }
        if !SearchModel.keyboard-visible && SearchModel.purpose == "books": PageBar {
            page: SearchModel.page;
            count: SearchModel.page-count;
            turn(direction) => { SearchModel.event("page", "" + direction); }
            jump => { SearchModel.event("jump", ""); }
        }
        if SearchModel.keyboard-visible || SearchModel.purpose != "books": TouchKeyboard {
            language: SearchModel.language;
            caps: SearchModel.caps;
            composition: SearchModel.composition;
            candidates: SearchModel.candidates;
            action-label: SearchModel.purpose == "thought" ? Strings.save : Strings.search;
            key(value) => {
                if value == "paste" {
                    root.paste-at-end = SearchModel.composition != "";
                    SearchModel.paste-ready = false;
                    SearchModel.event("prepare-paste", "");
                    if SearchModel.paste-ready {
                        root.paste-sequence += 1;
                    }
                } else {
                    SearchModel.event("key", value);
                    root.caret-sequence += 1;
                }
            }
            candidate(value) => { SearchModel.event("candidate", value); root.caret-sequence += 1; }
        }
    }
}
