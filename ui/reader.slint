                            Text { text: entry.subtitle + (entry.id == ArticleModel.current-id ? " · " + Strings.reading-current : ""); font-family: Theme.ui-font; font-size: 14px; color: entry.id == ArticleModel.current-id || row-touch.pressed ? Theme.paper : Theme.secondary; overflow: elide; }
                        }
                        Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
                        row-touch := SwipeTouchArea { tapped => { ArticleModel.event("article.open", entry.id); } swiped(value) => { ArticleModel.event("article.list-page", "" + value); } }
                    }
                    Rectangle { vertical-stretch: 1; }
                }
            }
            PageBar { page: ArticleModel.list-page; count: ArticleModel.list-pages; turn(value) => { ArticleModel.event("article.list-page", "" + value); } }
        }
    }
}

