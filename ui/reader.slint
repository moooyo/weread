                IconButton { icon: "close"; label: Strings.close; clicked => { ReaderModel.event("reader.selection-close", ""); } }
            }
            Text { text: ReaderModel.selection-text; font-family: Theme.serif-font; font-size: 18px; wrap: word-wrap; overflow: elide; height: 48px; }
            if ReaderModel.writing-thought: Rectangle {
