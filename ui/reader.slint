                if !Theme.scribe: OptionRow { label: Strings.font-weight; current: "" + ArticleModel.weight; options: [{id: "300", label: Strings.thin}, {id: "400", label: Strings.regular}, {id: "700", label: Strings.bold}]; selected(value) => { ArticleModel.event("article.weight", value); } }
                if !Theme.scribe: OptionRow { label: Strings.paragraph-spacing; current: ArticleModel.gap-choice; options: [{id: "tight", label: Strings.tight}, {id: "mid", label: Strings.normal}, {id: "loose", label: Strings.loose}]; selected(value) => { ArticleModel.event("article.paragraph-gap", value); } }
            }
        }
        Rectangle {
            y: root.content-height;
            height: Theme.scribe ? 76px : 64px;
            Rectangle { x: 0px; y: 0px; width: parent.width; height: 1px; background: Theme.line; }
            HorizontalLayout {
                ToolButton { label: Strings.article-list; icon: "list"; clicked => { ArticleModel.event("article.list", "true"); } }
                ToolButton { label: Strings.images; icon: "picture"; selected: ArticleModel.tool == "images"; clicked => { ArticleModel.event("article.tool", "images"); } }
                ToolButton { label: Strings.font; icon: "type"; selected: ArticleModel.tool == "type"; clicked => { ArticleModel.event("article.tool", "type"); } }
