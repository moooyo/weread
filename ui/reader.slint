                    OptionGroup { label: Strings.font-weight; current: "" + ArticleModel.weight; options: [{id: "300", label: Strings.thin}, {id: "400", label: Strings.regular}, {id: "700", label: Strings.bold}]; selected(value) => { ArticleModel.event("article.weight", value); } }
