export component ReaderScreen inherits Rectangle {
    background: Theme.paper;
    property <length> text-width: root.width - (Theme.scribe && ReaderModel.notes-panel ? 300px : 0px);
    property <length> body-top: ReaderModel.show-heading ? (Theme.scribe ? 204px : 164px) : (Theme.scribe ? 76px : 54px);
    property <length> start-x;
    property <length> start-y;
    property <bool> swiped;
    property <length> indent-width: ReaderModel.font-size * (ReaderModel.indent-choice == "0" ? 0px : ReaderModel.indent-choice == "1" ? 1px : 2px);
    Rectangle {
        x: 0px; y: 0px;
        width: root.text-width;
        height: root.height;
        Rectangle {
            x: 0px; y: 0px; width: parent.width;
            height: Theme.scribe ? 48px : 36px;
            HorizontalLayout {
                padding-left: ReaderModel.margin * 1px;
                padding-right: ReaderModel.margin * 1px;
                Text { text: ReaderModel.title; font-family: Theme.ui-font; font-size: 14px; color: Theme.secondary; vertical-alignment: bottom; overflow: elide; horizontal-stretch: 1; }
                Text { text: ReaderModel.clock; font-family: Theme.ui-font; font-size: 14px; color: Theme.secondary; vertical-alignment: bottom; }
            }
        }
        if ReaderModel.bookmarked: Rectangle {
            x: parent.width - ReaderModel.margin * 1px - 16px;
            y: 0px;
            width: 16px; height: 32px; background: Theme.ink;
        }
        if ReaderModel.show-heading: VerticalLayout {
            x: ReaderModel.margin * 1px;
            y: Theme.scribe ? 80px : 58px;
            width: parent.width - ReaderModel.margin * 2px;
            height: Theme.scribe ? 108px : 92px;
            spacing: 8px;
            Text { text: ReaderModel.chapter-meta; font-family: Theme.ui-font; font-size: 14px; color: Theme.secondary; }
            Text { text: ReaderModel.chapter-title; font-family: ReaderModel.font-family; font-size: Theme.scribe ? 36px : 30px; font-weight: 700; overflow: elide; }
            Text { text: ReaderModel.author; font-family: Theme.ui-font; font-size: 16px; color: Theme.secondary; }
        }
        body := Rectangle {
            x: ReaderModel.margin * 1px;
            y: root.body-top;
            width: parent.width - ReaderModel.margin * 2px;
            height: parent.height - root.body-top - 48px;
            clip: true;
            for line[index] in ReaderModel.lines: Rectangle {
                x: 0px; width: parent.width;
                y: line.height > 0 ? line.y * 1px : index * ReaderModel.font-size * ReaderModel.line-height * 1px;
                height: line.height > 0 ? line.height * 1px : ReaderModel.font-size * ReaderModel.line-height * 1px;
                Text {
                    x: line.indent ? root.indent-width : 0px;
                    y: 0px;
                    width: parent.width - self.x;
                    height: parent.height;
                    text: line.text;
                    horizontal-alignment: left;
                    font-family: ReaderModel.font-family;
                    font-size: ReaderModel.font-size * 1px;
                    font-weight: ReaderModel.weight;
                    letter-spacing: line.letter-spacing * 1px;
                    color: Theme.ink;
                    vertical-alignment: center;
                    overflow: clip;
                }
                for mark in line.marks: Rectangle {
                    x: mark.x * 1px;
                    y: min(parent.height - self.height - 1px, (parent.height + ReaderModel.font-size * 1px) / 2 + 1px);
                    width: mark.width * 1px;
                    height: mark.selected ? 3px : 2px;
                    background: mark.selected || (mark.mine && ReaderModel.mine) ? Theme.ink : transparent;
                    if mark.selected: Rectangle {
                        x: 0px; y: -5px; width: 3px; height: 8px;
                        background: Theme.ink;
                    }
                    if mark.selected: Rectangle {
                        x: max(0px, parent.width - 3px); y: -5px; width: 3px; height: 8px;
                        background: Theme.ink;
                    }
                    if !mark.selected && !mark.mine && ReaderModel.popular: DashedUnderline { }
                    if !mark.selected && !mark.mine && ReaderModel.popular && mark.count > 0: Text {
                        x: max(0px, parent.width - 36px);
                        y: -(line.height > 0 ? line.height * 1px : ReaderModel.font-size * ReaderModel.line-height * 1px) + 5px;
                        width: 36px;
                        height: 20px;
                        text: mark.count;
                        font-family: Theme.ui-font;
                        font-size: 14px;
                        horizontal-alignment: right;
                        color: Theme.secondary;
                    }
                }
            }
            if ReaderModel.lines.length == 0 && ReaderModel.images.length == 0 && !ReaderModel.access-notice: Text {
                y: 80px;
                text: ReaderModel.status == "" ? Strings.no-content : ReaderModel.status;
                font-family: Theme.ui-font;
                font-size: 18px;
                color: Theme.secondary;
                wrap: word-wrap;
                horizontal-alignment: center;
            }
        }
        Rectangle {
            x: 0px; width: parent.width;
            y: parent.height - (Theme.scribe ? 48px : 40px);
            height: Theme.scribe ? 48px : 40px;
            HorizontalLayout {
                padding-left: ReaderModel.margin * 1px;
                padding-right: ReaderModel.margin * 1px;
                spacing: 16px;
                Text { text: ReaderModel.chapter-title + (ReaderModel.access-label == "" ? "" : " · " + ReaderModel.access-label); font-family: Theme.ui-font; font-size: 14px; color: Theme.secondary; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                Text { text: ReaderModel.footer; font-family: Theme.ui-font; font-size: 14px; color: Theme.secondary; vertical-alignment: center; }
            }
        }
        surface := TouchArea {
            enabled: !ReaderModel.toc-open && !(ReaderModel.thought-open && !(Theme.scribe && ReaderModel.notes-panel && ReaderModel.thought-position == "side")) && !ReaderModel.selection-open && !ReaderModel.sync-conflict;
            pointer-event(event) => {
                if event.kind == PointerEventKind.down {
                    root.start-x = self.mouse-x;
                    root.start-y = self.mouse-y;
                    root.swiped = false;
                    ReaderModel.event("reader.press", "" + self.mouse-x / root.text-width + "," + (self.mouse-y - root.body-top) / (ReaderModel.font-size * ReaderModel.line-height * 1px) + "," + (self.mouse-y - root.body-top) / 1px);
                }
                if event.kind == PointerEventKind.move && self.pressed {
                    ReaderModel.event("reader.move", "" + self.mouse-x / root.text-width + "," + (self.mouse-y - root.body-top) / (ReaderModel.font-size * ReaderModel.line-height * 1px) + "," + (self.mouse-y - root.body-top) / 1px);
                }
                if event.kind == PointerEventKind.up {
                    if abs(self.mouse-x - root.start-x) >= 64px && abs(self.mouse-x - root.start-x) > abs(self.mouse-y - root.start-y) {
                        root.swiped = true;
                    }
                    if abs(self.mouse-y - root.start-y) >= 64px { root.swiped = true; }
                    ReaderModel.event("reader.release", "" + self.mouse-x / root.text-width + "," + (self.mouse-y - root.body-top) / (ReaderModel.font-size * ReaderModel.line-height * 1px) + "," + (self.mouse-y - root.body-top) / 1px);
                    if !ReaderModel.selection-open {
                        if abs(self.mouse-x - root.start-x) >= 64px && abs(self.mouse-x - root.start-x) > abs(self.mouse-y - root.start-y) {
                            ReaderModel.event("reader.turn", self.mouse-x < root.start-x ? "1" : "-1");
                        } else if !root.swiped {
                            ReaderModel.event("reader.tap", "" + self.mouse-x / root.text-width);
                        }
                    }
                }
                if event.kind == PointerEventKind.cancel {
                    ReaderModel.event("reader.cancel", "");
                }
            }
        }
        Rectangle {
            x: ReaderModel.margin * 1px;
            y: root.body-top;
            width: parent.width - ReaderModel.margin * 2px;
            height: parent.height - root.body-top - 48px;
            clip: true;
            for picture in ReaderModel.images: Rectangle {
                x: (parent.width - self.width) / 2;
                y: picture.y * 1px;
                width: min(parent.width, picture.width * 1px);
                height: picture.height * 1px;
                if picture.loaded: Image {
                    x: 0px; y: 0px;
                    width: parent.width;
                    height: max(1px, parent.height - 24px);
                    source: picture.picture;
                    image-fit: contain;
                }
                if !picture.loaded: Rectangle {
                    x: 0px; y: 0px;
                    width: parent.width;
                    height: max(1px, parent.height - 24px);
                    border-width: 2px;
                    border-color: Theme.line;
                    background: image-touch.pressed ? Theme.ink : Theme.paper;
                    VerticalLayout {
                        padding: 16px;
                        alignment: center;
                        spacing: 8px;
                        Text { text: Strings.load-image; font-family: Theme.ui-font; font-size: 18px; color: image-touch.pressed ? Theme.paper : Theme.ink; horizontal-alignment: center; wrap: word-wrap; }
                    }
                    accessible-role: button;
                    accessible-label: Strings.load-image;
                    image-touch := TouchArea {
                        pointer-event(event) => { if event.kind == PointerEventKind.down { Theme.refresh("press"); } else if event.kind == PointerEventKind.up { Theme.refresh("release"); } }
                        clicked => { ReaderModel.event("reader.load-image", picture.id); }
                    }
                }
                Text {
                    x: 0px; y: max(0px, parent.height - 24px);
                    width: parent.width; height: 24px;
                    text: picture.caption;
                    font-family: Theme.ui-font;
                    font-size: 14px;
                    color: Theme.secondary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
        if ReaderModel.lines.length == 0 && ReaderModel.images.length == 0 && !ReaderModel.access-notice: ActionButton {
            x: (parent.width - 280px) / 2;
            y: root.body-top + 200px;
            width: 280px;
            text: Strings.download;
            primary: true;
            enabled: ReaderModel.can-download && !ReaderModel.download-busy;
            clicked => { ReaderModel.event("reader.download", "current"); }
        }
        if ReaderModel.access-notice: Rectangle {
            x: ReaderModel.margin * 1px;
            y: root.body-top + ReaderModel.access-offset * 1px;
            width: parent.width - ReaderModel.margin * 2px;
            height: 148px;
            background: Theme.paper;
            VerticalLayout {
                spacing: 12px;
                alignment: start;
                Text {
                    height: 64px;
                    text: ReaderModel.access-hint;
                    font-family: Theme.ui-font;
                    font-size: 16px;
                    color: Theme.secondary;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                HorizontalLayout {
                    alignment: center;
                    ActionButton {
                        width: min(280px, parent.width);
                        text: ReaderModel.download-busy ? Strings.content-refreshing : ReaderModel.access-action;
                        enabled: ReaderModel.can-download && !ReaderModel.download-busy;
                        clicked => { ReaderModel.event("reader.refresh-access", ""); }
                    }
                }
            }
        }
    }

    if Theme.scribe && ReaderModel.notes-panel: Rectangle {
        x: root.text-width;
        y: 0px;
        width: 300px;
        height: root.height;
        background: Theme.paper;
        Rectangle { x: 0px; y: 0px; width: 1px; height: parent.height; background: Theme.line; }
        VerticalLayout {
            spacing: 0px;
            Rectangle {
                height: 76px;
                HorizontalLayout {
                    padding-left: 24px; padding-right: 8px;
                    Text { text: Strings.current-page-notes + " " + ReaderModel.thought-count; font-family: Theme.ui-font; font-size: 19px; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; }
                    IconButton { icon: "close"; label: Strings.close; clicked => { ReaderModel.event("reader.panel", "false"); } }
                }
                Rectangle { y: parent.height - 2px; height: 2px; background: Theme.ink; }
            }
            Rectangle {
                clip: true;
                vertical-stretch: 1;
                VerticalLayout {
                    spacing: 0px;
                    for thought in ReaderModel.thoughts: ThoughtCard { entry: thought; clicked => { ReaderModel.event("reader.thought", thought.id); } }
                    if ReaderModel.thoughts.length == 0: Text { text: Strings.no-annotations; font-family: Theme.ui-font; font-size: 16px; color: Theme.secondary; wrap: word-wrap; width: 252px; x: 24px; }
                    Rectangle { vertical-stretch: 1; }
                }
            }
            if ReaderModel.thought-pages > 1: HorizontalLayout {
                height: 48px;
                padding-left: 8px; padding-right: 8px;
                IconButton { icon: "back"; label: Strings.previous-page; enabled: ReaderModel.thought-page > 1; clicked => { ReaderModel.event("reader.thought-page", "-1"); } }
                Text { text: ReaderModel.thought-page + " / " + ReaderModel.thought-pages; font-family: Theme.ui-font; font-size: 16px; horizontal-alignment: center; vertical-alignment: center; horizontal-stretch: 1; }
                IconButton { icon: "next"; label: Strings.next-page; enabled: ReaderModel.thought-page < ReaderModel.thought-pages; clicked => { ReaderModel.event("reader.thought-page", "1"); } }
            }
        }
    }

    if ReaderModel.menu: ReaderMenu { }
    if ReaderModel.toc-open: ReaderContents { }
    if ReaderModel.thought-open: ThoughtPopup { }
    if ReaderModel.selection-open: SelectionPopup { }
    if ReaderModel.sync-conflict: SyncConflictPopup { }
}

export component ArticleScreen inherits Rectangle {
    background: Theme.paper;
    property <length> page-margin: Theme.scribe ? 72px : 32px;
    property <length> start-x;
    property <length> start-y;
    property <bool> swiped;
    Rectangle {
        x: 0px; y: 0px; width: root.width;
        height: Theme.scribe ? 48px : 36px;
        HorizontalLayout {
            padding-left: root.page-margin; padding-right: root.page-margin;
            Text { text: ArticleModel.account + " · " + Strings.publications; font-family: Theme.ui-font; font-size: 14px; color: Theme.secondary; vertical-alignment: bottom; overflow: elide; horizontal-stretch: 1; }
            Text { text: ArticleModel.clock; font-family: Theme.ui-font; font-size: 14px; color: Theme.secondary; vertical-alignment: bottom; }
        }
    }
    article-surface := TouchArea {
        enabled: !ArticleModel.list-open && !ArticleModel.qr-open;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down { root.start-x = self.mouse-x; root.start-y = self.mouse-y; root.swiped = false; }
            if event.kind == PointerEventKind.up {
                if abs(self.mouse-x - root.start-x) >= 64px && abs(self.mouse-x - root.start-x) > abs(self.mouse-y - root.start-y) {
                    root.swiped = true;
                    ArticleModel.event("article.turn", self.mouse-x < root.start-x ? "1" : "-1");
                }
                if abs(self.mouse-y - root.start-y) >= 64px { root.swiped = true; }
            }
        }
        clicked => { if !root.swiped { ArticleModel.event("article.tap", "" + self.mouse-x / root.width); } }
    }
    Rectangle {
        x: root.page-margin;
        y: Theme.scribe ? 80px : 54px;
        width: root.width - root.page-margin * 2;
        height: root.height - self.y - (Theme.scribe ? 56px : 48px);
        clip: true;
        VerticalLayout {
            spacing: 0px;
            for block in ArticleModel.blocks: Rectangle {
                height: block.height * 1px;
                background: Theme.paper;
                if block.kind == "title": Text { x: 0px; y: 0px; width: parent.width; height: parent.height; horizontal-alignment: left; vertical-alignment: top; text: block.text; font-family: Theme.serif-font; font-size: Theme.scribe ? 38px : 28px; font-weight: 700; wrap: word-wrap; overflow: elide; }
                if block.kind == "meta": Rectangle {
                    x: 0px; y: 0px; width: parent.width; height: parent.height;
                    HorizontalLayout {
                        y: 0px; height: parent.height - 16px; spacing: 12px;
                        Rectangle { width: Theme.scribe ? 42px : 34px; height: Theme.scribe ? 42px : 34px; border-radius: self.width / 2; background: Theme.ink; Text { text: ArticleModel.account-initial; font-family: Theme.serif-font; font-size: Theme.scribe ? 18px : 15px; font-weight: 700; color: Theme.paper; horizontal-alignment: center; vertical-alignment: center; } }
                        VerticalLayout {
                            alignment: center; spacing: 4px; horizontal-stretch: 1;
                            Text { text: ArticleModel.account; font-family: Theme.ui-font; font-size: Theme.scribe ? 18px : 15px; font-weight: 700; }
                            Text { text: block.text; font-family: Theme.ui-font; font-size: Theme.scribe ? 15px : 14px; color: Theme.secondary; overflow: elide; }
                        }
                    }
                    Rectangle { x: 0px; y: parent.height - 8px; width: parent.width; height: 1px; background: Theme.line; }
                }
                if block.kind == "line" || block.kind == "paragraph" || block.kind == "heading": Text {
                    x: 0px; y: 0px; width: parent.width; height: block.content-height > 0 ? block.content-height * 1px : parent.height;
                    horizontal-alignment: left; vertical-alignment: center;
                    text: block.text;
                    font-family: ArticleModel.font-family;
                    font-size: ArticleModel.font-size * (block.kind == "heading" ? 1.1px : 1px);
                    font-weight: block.kind == "heading" ? 700 : ArticleModel.weight;
                    letter-spacing: block.letter-spacing * 1px;
                    wrap: no-wrap;
                    overflow: clip;
                }
                if block.kind == "quote": Rectangle {
                    x: 0px; y: 0px; width: parent.width;
                    height: (block.inset-top + ceil(block.content-height) + block.inset-bottom) * 1px;
                    background: Theme.fill;
                    border-top-left-radius: block.inset-top > 0 ? 6px : 0px;
                    border-top-right-radius: block.inset-top > 0 ? 6px : 0px;
                    border-bottom-left-radius: block.inset-bottom > 0 ? 6px : 0px;
                    border-bottom-right-radius: block.inset-bottom > 0 ? 6px : 0px;
                    Text {
                        x: block.inset-horizontal * 1px; y: block.inset-top * 1px;
                        width: parent.width - block.inset-horizontal * 2px; height: block.content-height * 1px;
                        text: block.text;
                        font-family: Theme.serif-font;
                        font-size: ArticleModel.font-size * 0.95px;
                        font-weight: ArticleModel.weight;
                        letter-spacing: block.letter-spacing * 1px;
                        vertical-alignment: center;
                        wrap: no-wrap;
                        overflow: clip;
                    }
                }
                if block.kind == "image": Rectangle {
                    x: 0px; y: 0px;
                    width: parent.width;
                    height: block.frame-height * 1px;
                    border-radius: 6px;
                    clip: true;
                    background: image-touch.pressed ? Theme.fill : Theme.paper;
                    if block.loaded: Image { x: 0px; y: 0px; width: parent.width; height: parent.height; source: block.picture; image-fit: cover; }
                    if !block.loaded: VerticalLayout {
                        alignment: center; spacing: 8px;
                        Rectangle { height: Theme.scribe ? 40px : 34px; Icon { x: (parent.width - self.width) / 2; y: 0px; width: Theme.scribe ? 40px : 34px; height: self.width; kind: "picture"; } }
                        Text { text: Strings.load-image; font-family: Theme.ui-font; font-size: 17px; font-weight: 700; horizontal-alignment: center; }
                        if block.meta != "": Text { text: block.meta; font-family: Theme.ui-font; font-size: 14px; color: Theme.secondary; horizontal-alignment: center; }
                    }
                    if !block.loaded: DashedOutline { stroke-color: Theme.ink; stroke: 2px; radius: 6px; }
                    image-touch := SwipeTouchArea { enabled: !block.loaded; tapped => { ArticleModel.event("article.load-image", block.id); } swiped(value) => { ArticleModel.event("article.turn", "" + value); } }
                }
                if block.kind == "image": Text { x: 0px; width: parent.width; y: (block.frame-height + block.caption-gap) * 1px; height: block.caption-height * 1px; text: block.text; font-family: Theme.ui-font; font-size: Theme.scribe ? 15px : 14px; color: Theme.secondary; horizontal-alignment: center; overflow: elide; }
                if block.kind == "end": ArticleEnding { }
            }
            if ArticleModel.blocks.length == 0: VerticalLayout {
                alignment: center; spacing: 20px;
                Text { text: ArticleModel.title; font-family: Theme.serif-font; font-size: 28px; font-weight: 700; wrap: word-wrap; horizontal-alignment: center; }
                Text { text: ArticleModel.status == "" ? Strings.no-content : ArticleModel.status; font-family: Theme.ui-font; font-size: 18px; color: Theme.secondary; wrap: word-wrap; horizontal-alignment: center; }
                ActionButton { text: Strings.download; primary: true; enabled: ArticleModel.can-download && !ArticleModel.download-busy; clicked => { ArticleModel.event("article.download", ""); } }
            }
            Rectangle { vertical-stretch: 1; }
        }
    }
    Rectangle {
        x: 0px; width: root.width;
        y: root.height - (Theme.scribe ? 48px : 40px);
        height: Theme.scribe ? 48px : 40px;
        HorizontalLayout {
            padding-left: root.page-margin; padding-right: root.page-margin; spacing: 16px;
            Text { text: ArticleModel.title; font-family: Theme.ui-font; font-size: 14px; color: Theme.secondary; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
            Text { text: ArticleModel.footer; font-family: Theme.ui-font; font-size: 14px; color: Theme.secondary; vertical-alignment: center; }
        }
    }
    if ArticleModel.menu: ArticleMenu { }
    if ArticleModel.list-open: ArticleList { }
    if ArticleModel.qr-open: ArticleQr { }
}

