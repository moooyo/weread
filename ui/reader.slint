                if !ReaderModel.writing-thought: ActionButton { text: Strings.copy; horizontal-stretch: 1; clicked => { copy-source.select-all(); copy-source.copy(); ReaderModel.event("reader.copy", ""); } }
                if ReaderModel.writing-thought: ActionButton { text: Strings.cancel; horizontal-stretch: 1; clicked => { ReaderModel.event("reader.selection-close", ""); } }
                if ReaderModel.writing-thought: ActionButton { text: Strings.save; primary: true; enabled: ReaderModel.thought-draft != ""; horizontal-stretch: 1; clicked => { ReaderModel.event("reader.save-thought", ""); } }
