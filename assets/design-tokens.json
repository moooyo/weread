      "settings": "single column: list -> sub-page (back to 我的, bottom tabs kept)"
    },
    "rule": "Every screen is a single column on both devices (the Scribe reader's collapsible highlight panel is the only exception); no split panes, no side tabs. Scribe uses the extra space for more rows / columns."
  },
  "gesture": {
    "readerZones": {
      "prev": [
        0,
        0.3
      ],
      "menu": [
        0.3,
        0.7
      ],
      "next": [
        0.7,
        1.0
      ],
      "options": [
        "default",
        "mirrored (left-hand)",
        "swipe only"
      ]
    },
    "swipeMinDistance": 64,
    "verticalSwipe": "ignored in reader",
    "longPress": "select text -> 划线 / 写想法 / 复制",
    "pinch": "font size, reflow on release",
    "edgeGuard": {
      "default": true,
      "widthFraction": 0.2,
      "note": "taps in edge zones turn pages instead of opening highlights"
    }
  },
  "refresh": {
    "names": "KOReader UIManager:setDirty names; waveforms GC16 / GL16 / DU / A2",
    "enterScreen": "flashui",
    "tabSwitchOrListPage": "ui (a full refresh after every 6 partial updates)",
    "pressFeedback": "fast (invert within ~100 ms, restore with ui on release)",
    "overlayOpen": "ui (overlay rect only)",
    "overlayClose": "flashpartial (former rect)",
    "progressTick": "fast, at most once per second",
    "readerPageTurn": "partial; full every N pages (N default 6; options 1 / 6 / 12 / never)",
    "imageFirstShow": "full (GC16 for 16 gray levels)"
  },
  "timing": {
    "toast": 2000,
    "progressMinInterval": 1000,
    "animations": "none"
  }
