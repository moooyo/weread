    "paragraphGap": {
      "default": "mid",
      "tight": "0.5em",
      "mid": "0.9em",
      "loose": "1.4em"
    },
    "note": "Article typography is stored separately from book typography."
  },
  "space": {
    "scale": [
      4,
      8,
      12,
      16,
      20,
      24,
      32,
      48
    ],
    "pageMargin": {
      "pw": 20,
      "scribe": 32
    },
    "minGapBetweenTargets": 8
  },
  "size": {
    "touchMin": 48,
    "icon": 24,
    "iconStroke": 2,
    "statusBar": 28,
    "searchBar": 52,
    "titleBar": 52,
    "sortTabs": 44,
    "bottomNav": {
      "pw": 64,
      "scribe": 76
    },
    "button": 48,
    "chip": 36,
    "row": {
      "single": 56,
      "double": 72,
      "toc": 52
